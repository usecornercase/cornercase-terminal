{
  "worktrees_dir": "worktrees",
  "fetch_minutes": 12,
  "pull_requests": false,
  "merged_pull_requests": false,
  "shared_files": true,
  "issue_branch": "feat/{key}-{slug}",
  "issue_tabs": [
    "shortcut",
    "github",
    "gitlab"
  ],
  "gitlab_url": "https://gitlab.acme.dev",
  "jira_site": "acme.atlassian.net",
  "jira_email": "ana@acme.dev",
  "jira_jql": "project = SHOP",
  "plane_url": "https://plane.example",
  "plane_workspace": "shop",
  "plane_filter": "state:todo",
  "asana_workspace": "Acme",
  "asana_projects": "1200000000000001 1200000000000002",
  "agent": "codex",
  "agent_args": {
    "codex": [
      "--sandbox",
      "workspace-write"
    ]
  },
  "agent_modes": {
    "claude": {
      "plan": [
        "--permission-mode",
        "plan"
      ]
    }
  },
  "agent_commands": {
    "codex": "fake-codex"
  },
  "prompt": "Fix {url}",
  "submit": true,
  "accept_trust_prompts": true,
  "resume_agents": false,
  "keep_awake": true,
  "hidden_flows": [
    "Arena"
  ],
  "default_flow": "Quick",
  "flow_order": [
    "Quick",
    "Arena"
  ],
  "trust_prompt_pattern": "Allow this folder",
  "gh": "fake-gh",
  "glab": "fake-glab",
  "sidebar": "tree",
  "tabs": "top",
  "icon_bar": true,
  "icons": "on",
  "agents_section": true,
  "working_icon": "spinner",
  "counts": false,
  "todo_dot": false,
  "dim_inactive_panes": false,
  "prefix_key": "ctrl+]",
  "model": false,
  "context": false,
  "memory": true,
  "account_mark": false,
  "account_switcher": false,
  "account_picker": false,
  "desktop_notifications": "off",
  "sound": true,
  "sound_waiting": "~/sounds/ping.wav",
  "sound_done": "/usr/share/sounds/done.oga",
  "sound_subagents": true,
  "check_updates": false,
  "star_prompt": false,
  "tour": false,
  "remote": true,
  "remote_port": 47682,
  "discord_forum": true,
  "discord_forum_close": "delete",
  "projects": {
    "~/code/web-shop": {
      "setup": "npm ci\ncp ../.env .env",
      "teardown": "docker compose down",
      "builds": [
        "node_modules",
        ".next"
      ]
    }
  },
  "account_names": {
    "claude": {
      "": "work",
      "home": "Personal"
    }
  },
  "active_accounts": {
    "claude": "home"
  }
}
