---
import { localeOf, words } from '../../i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).more;
const links: string[][] = [
  [
    'guides/projects-workspaces-tabs/#how-full-the-context-is',
    'guides/projects-workspaces-tabs/#notifications',
    'guides/projects-workspaces-tabs/#usage-and-stats',
    'guides/telegram/',
    'guides/worktrees/',
    'guides/queue/',
  ],
  ['guides/files/', 'guides/search/', 'guides/panes-and-splits/', 'guides/todo/', 'guides/worktrees/#pull-requests-and-their-checks'],
  [
    '#a-few-deliberate-choices',
    'reference/keyboard-and-mouse/',
    'help/faq/#does-it-respect-my-terminals-colour-theme',
    'guides/small-terminals/',
    'guides/remote/',
    'guides/plugins/',
    'installation/#update',
  ],
];
const groups = t.groups.map(({ name, items }, i) => ({
  name,
  items: items.map(([title, text], j) => ({ title, text, path: links[i][j] })),
}));
---

<section class="section more" id="more" aria-labelledby="more-title">
  <div class="wrap">
    <h2 class="h2 reveal" id="more-title">{t.title}</h2>
    <div class="lists">
      {
        groups.map(({ name, items }) => (
          <section class="list" aria-label={name}>
            <h3 class="reveal">{name}</h3>
            <ul>
              {items.map(({ title, text, path }, i) => (
                <li class="reveal" style={`--i: ${i % 2}`}>
                  <a href={docs(path)} hreflang={docsLang}>
                    <b>{title}</b>
                    <span>{text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section.more {
    padding-top: 0;
  }

  .lists {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
    margin-top: clamp(40px, 5vw, 64px);
  }

  .list {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 24px clamp(28px, 4.5vw, 72px);
    padding-top: clamp(24px, 2.6vw, 32px);
    border-top: 2px solid var(--text);
  }

  h3 {
    position: sticky;
    top: 96px;
    align-self: start;
    margin: 0;
    font-stretch: var(--wide);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 760;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px clamp(24px, 3vw, 44px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: var(--text);
  }

  b {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  a:hover b {
    text-decoration-color: var(--brand);
  }

  a span {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
    }

    h3 {
      position: static;
    }
  }

  @media (max-width: 600px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
  }
</style>
