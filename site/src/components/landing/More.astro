---
import { localeOf, words } from '../../i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).more;
const links: [string, string][][] = [
  [
    ['◐', 'guides/projects-workspaces-tabs/#how-full-the-context-is'],
    ['◆', 'guides/flows/'],
    ['!', 'guides/projects-workspaces-tabs/#notifications'],
    ['%', 'guides/projects-workspaces-tabs/#usage-and-stats'],
    ['✈\uFE0E', 'guides/telegram/'],
    ['⎇', 'guides/worktrees/'],
    ['◷', 'guides/queue/'],
  ],
  [
    ['▤', 'guides/files/'],
    ['⌕', 'guides/search/'],
    ['│', 'guides/panes-and-splits/'],
    ['○', 'guides/todo/'],
    ['✓', 'guides/worktrees/#pull-requests-and-their-checks'],
  ],
  [
    ['▮', '#a-few-deliberate-choices'],
    ['↖', 'reference/keyboard-and-mouse/'],
    ['◧', 'help/faq/#does-it-respect-my-terminals-colour-theme'],
    ['▯', 'guides/small-terminals/'],
    ['⇅', 'guides/remote/'],
    ['↑', 'installation/#update'],
  ],
];
const groups = t.groups.map(({ name, items }, i) => ({
  name,
  items: items.map(([title, text], j) => ({ title, text, glyph: links[i][j][0], path: links[i][j][1] })),
}));
---

<section class="section more" id="more" aria-labelledby="more-title">
  <div class="wrap">
    <h2 class="h2" id="more-title">{t.title}</h2>
    <div class="lists">
      {
        groups.map(({ name, items }) => (
          <section class="list" aria-label={name}>
            <h3>{name}</h3>
            <ul>
              {items.map(({ glyph, title, text, path }) => (
                <li class="reveal">
                  <a href={docs(path)} hreflang={docsLang}>
                    <span class="glyph" aria-hidden="true">
                      {glyph}
                    </span>
                    <span class="body">
                      <b>{title}</b>
                      <span>{text}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section.more {
    padding-top: 0;
  }

  .h2 {
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .lists {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
    margin-top: clamp(28px, 4vw, 44px);
  }

  .list {
    min-width: 0;
  }

  h3 {
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-2);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    text-decoration: none;
    color: var(--text);
  }

  .glyph {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--cyan);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .body b {
    font-family: var(--font-display);
    font-size: 16.5px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  a:hover .body b {
    color: var(--purple-3);
  }

  .body span {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .lists {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
