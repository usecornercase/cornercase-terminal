---
import { words } from '../../i18n';
import Mark from './Mark.astro';

const server = words(Astro.url).why.diagram.server;
const procs = ['claude', 'codex', 'claude', 'npm run dev'];
const pictures = ['projects', 'agents', 'issues', 'changes', 'files', 'flow'];
---

<div class="scene" aria-hidden="true" data-scene>
  <div class="layer layer-server" data-layer="server">
    <span class="plate"><Mark size={14} />{server}</span>
    <ul>{procs.map((p) => <li><i />{p}</li>)}</ul>
  </div>
  <div class="rig" data-rig>
    <div class="win" data-win>
      <i class="corner corner-h"></i>
      <i class="corner corner-v"></i>
      <div class="bar"><span class="name">cornercase · ~/code/web-shop</span><span class="size" data-win-size></span></div>
      <div class="screen">
        <canvas data-screen></canvas>
        <div class="spot" data-spot></div>
        <div class="ptr" data-ptr>
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2.5v17.2l4.6-4.4 2.9 6.6 3-1.3-2.9-6.5h6.4z" fill="#f7f8fa" stroke="#0c0e11" stroke-width="1.4" stroke-linejoin="round"></path></svg>
          <span class="tap" data-ptr-tap></span>
        </div>
      </div>
    </div>
  </div>
  {pictures.map((name) => <div class="layer" data-layer={name}><canvas></canvas></div>)}
  <div class="layer layer-phone" data-layer="phone"><i class="ear"></i><canvas></canvas></div>
  <div class="layer layer-cli" data-layer="cli"><span class="ps">$</span>cornercase start codex --worktree feat/gift-cards</div>
</div>

<style>
  .scene {
    display: none;
  }

  :global(.motion) .scene {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    transition: opacity 0.8s ease-out;
  }

  :global(.intro) .scene {
    opacity: 0;
  }

  .rig {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }

  .win {
    position: absolute;
    inset: 0;
    border: 1px solid #2c2f44;
    background: var(--term);
    color: var(--term-text);
    box-shadow:
      0 60px 140px -20px rgb(0 0 0 / 0.8),
      0 30px 90px -30px rgb(0 70 220 / 0.55);
  }

  .corner {
    position: absolute;
    background: var(--brand);
  }

  .corner-h {
    left: -1px;
    top: -15px;
    width: 22%;
    max-width: 240px;
    height: 6px;
  }

  .corner-v {
    left: -15px;
    top: -1px;
    width: 6px;
    height: 34%;
    max-height: 240px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid var(--term-line);
    background: var(--term-bar);
    color: var(--term-text-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    white-space: nowrap;
  }

  .size {
    opacity: 0.7;
  }

  .screen {
    position: absolute;
    left: 10px;
    top: 44px;
  }

  canvas {
    display: block;
    max-width: none;
  }

  .spot {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    outline: 2px solid #74a3ff;
    box-shadow: 0 0 0 4000px rgb(10 11 16 / 0.6);
    transition:
      opacity 0.3s ease-out,
      left 0.45s var(--expo),
      top 0.45s var(--expo),
      width 0.45s var(--expo),
      height 0.45s var(--expo);
  }

  .ptr {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    transition: opacity 0.25s ease-out;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.45));
  }

  .ptr svg {
    position: absolute;
    left: -3px;
    top: -2px;
  }

  .layer {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    visibility: hidden;
    opacity: 0;
    border: 1px solid #343850;
    background: var(--term);
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.75);
    transition:
      border-color 0.25s ease-out,
      box-shadow 0.25s ease-out;
  }

  .layer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 11 16 / 0.3);
    transition: opacity 0.25s ease-out;
  }

  .layer:global(.is-on)::after {
    opacity: 0;
  }

  .layer:global(.is-on) {
    border-color: #74a3ff;
    box-shadow:
      0 0 0 1px #74a3ff,
      0 0 60px rgb(0 95 255 / 0.55),
      0 30px 70px -20px rgb(0 0 0 / 0.75);
  }

  .layer-server {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 14px;
    padding: 0 26px 22px;
    border: 2px solid #3d6dff;
    background: rgb(19 20 28 / 0.94);
  }

  .plate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #e4e7f2;
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 700;
  }

  .plate :global(.mark .k) {
    fill: #e4e7f2;
  }

  .plate :global(.mark .c) {
    fill: #74a3ff;
  }

  .layer-server ul {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layer-server li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 12px;
    border: 1px solid #2c2f40;
    background: var(--term);
    color: #e4e7f2;
    font-family: var(--font-mono);
    font-size: 14px;
    white-space: nowrap;
  }

  .layer-server li i {
    width: 8px;
    height: 8px;
    background: #58e6a0;
  }

  .layer-phone {
    padding: 26px 8px 14px;
    border: 2px solid #4a4f6a;
    background: #0d0e14;
  }

  .ear {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 54px;
    height: 5px;
    margin-left: -27px;
    background: #2c2f40;
  }

  .layer-cli {
    display: flex;
    align-items: center;
    gap: 12px;
    overflow: hidden;
    padding: 0 18px;
    color: #e4e7f2;
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ps {
    color: #74a3ff;
  }

  .tap {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border: 2px solid #74a3ff;
    border-radius: 50%;
    opacity: 0;
  }
</style>
