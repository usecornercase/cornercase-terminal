---
import '../../styles/flowshow.css';
import { localeOf, words } from '../../i18n';
import { graphSvg } from '../../lib/flowshow/svg';
import { CAPTIONS, FINAL } from '../../lib/flowshow/timeline';
import Rich from './Rich.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).flows;
const glyphs = ['⇄', '∥', '◐', '◆'];
---

<section class="section flows" id="flows" aria-labelledby="flows-title">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2" id="flows-title">{t.title[0]}{' '}<em>{t.title[1]}</em></h2>
      <p class="lead"><Rich text={t.lead} /></p>
    </div>

    <figure class="show reveal" data-flowshow data-mood={FINAL.mood}>
      <div class="marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="window">
        <div class="window-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="window-title">Flow · web-shop › issue-482-returns-page-crashes</span>
          <button type="button" class="tui toggle" data-toggle data-pause={t.pause} data-play={t.play}>{t.pause}</button>
        </div>
        <div class="stage">
          <Fragment set:html={graphSvg('wide')} />
          <Fragment set:html={graphSvg('tall')} />
        </div>
        <div class="strip" aria-hidden="true">
          <span class="mood"><b class="s working">◐</b><b class="s waiting">!</b><b class="s done">✓</b></span>
          <span class="say">
            {CAPTIONS.map((k) => <span data-say={k} class:list={[{ on: k === FINAL.caption }]}>{t.steps[k]}</span>)}
          </span>
        </div>
      </div>
      <figcaption class="sr-only">{t.label}</figcaption>
    </figure>

    <ul class="points">
      {
        t.points.map(([title, text], i) => (
          <li class="reveal">
            <span class="glyph" aria-hidden="true">{glyphs[i]}</span>
            <span class="body"><b>{title}</b><span>{text}</span></span>
          </li>
        ))
      }
    </ul>
    <p class="links reveal">
      <a class="more" href={`${base}/docs/guides/flows/`} hreflang={docsLang}>{t.more}</a>
      <a class="more" href={`${base}/flows/`} hreflang={docsLang}>{t.community}</a>
    </p>
  </div>
</section>

<script>
  import { mount } from '../../lib/flowshow/client';

  for (const root of document.querySelectorAll<HTMLElement>('[data-flowshow]')) mount(root);
</script>

<style>
  .section.flows {
    position: relative;
    isolation: isolate;
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(50% 40% at 30% 45%, rgb(135 95 255 / 0.16), transparent 70%),
      radial-gradient(40% 35% at 75% 55%, rgb(69 217 232 / 0.09), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.05) 1px, transparent 0) 0 0 / 24px 24px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 40%, transparent 100%);
  }

  .h2 {
    max-width: 20ch;
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .h2 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--purple-2) 10%, #d8cbff 55%, var(--cyan) 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    margin: 14px 0 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: 17px;
  }

  .show {
    position: relative;
    margin: clamp(28px, 4vw, 44px) 0 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    padding: clamp(10px, 2vw, 22px);
    background:
      radial-gradient(60% 70% at 50% 40%, rgb(135 95 255 / 0.14), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.06) 1px, transparent 0) 0 0 / 22px 22px,
      var(--term);
  }

  .stage :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .stage :global(.fs-tall) {
    display: none;
  }

  @media (max-width: 999px) {
    .stage :global(.fs-wide) {
      display: none;
    }

    .stage :global(.fs-tall) {
      display: block;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  .toggle {
    margin-left: auto;
    flex: none;
  }

  :global(html:not(.js)) .toggle,
  [data-still] .toggle {
    display: none;
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--line);
    color: var(--text-2);
    font-size: 14px;
  }

  .mood {
    flex: none;
    width: 1.4em;
    text-align: center;
    font-family: var(--font-mono);
  }

  .mood .s {
    display: none;
  }

  [data-mood='working'] .mood .working {
    display: inline;
    color: var(--yellow);
  }

  [data-mood='waiting'] .mood .waiting {
    display: inline;
    color: #ff8700;
  }

  [data-mood='done'] .mood .done {
    display: inline;
    color: var(--green);
  }

  .say {
    display: grid;
    min-width: 0;
  }

  .say > span {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }

  .say > :global(.on) {
    opacity: 1;
    transform: none;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 28px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 8px;
  }

  .glyph {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 17px;
    line-height: 1.3;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .body b {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .body span {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: clamp(24px, 3vw, 36px) 0 0;
  }

  .more {
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .more:hover {
    color: var(--purple-3);
  }

  @media (max-width: 1000px) {
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
