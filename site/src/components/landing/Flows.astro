---
import '../../styles/flowshow.css';
import { localeOf, words } from '../../i18n';
import { graphSvg } from '../../lib/flowshow/svg';
import { CAPTIONS, FINAL } from '../../lib/flowshow/timeline';
import Rich from './Rich.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).flows;
---

<section class="section flows" id="flows" aria-labelledby="flows-title">
  <div class="reel" data-section="flows">
   <div class="pin wrap">
    <div class="head" data-flows-head>
      <h2 class="h2" id="flows-title" data-title><span class="line">{t.title[0]}</span>{' '}<span class="line">{t.title[1]}</span></h2>
      <p class="lead"><Rich text={t.lead} /></p>
    </div>

    <figure class="show" data-flowshow data-mood={FINAL.mood}>
      <div class="window">
        <div class="window-bar">
          <span class="window-title">Flow · web-shop › issue-482-returns-page-crashes</span>
          <button type="button" class="tui toggle" data-toggle data-pause={t.pause} data-play={t.play}>{t.pause}</button>
        </div>
        <div class="stage">
          <Fragment set:html={graphSvg('wide')} />
          <Fragment set:html={graphSvg('tall')} />
        </div>
        <div class="strip" aria-hidden="true">
          <span class="mood"><b class="s working">◐</b><b class="s waiting">!</b><b class="s done">✓</b></span>
          <span class="say">
            {CAPTIONS.map((k) => <span data-say={k} class:list={[{ on: k === FINAL.caption }]}>{t.steps[k]}</span>)}
          </span>
        </div>
      </div>
      <figcaption class="sr-only">{t.label}</figcaption>
    </figure>
   </div>
  </div>

  <div class="wrap rest backed">
    <ul class="points">
      {
        t.points.map(([title, text], i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <b>{title}</b>
            <span>{text}</span>
          </li>
        ))
      }
    </ul>
    <p class="links reveal">
      <a class="more" href={`${base}/docs/guides/flows/`} hreflang={docsLang}>{t.more}</a>
      <a class="more" href={`${base}/flows/`} hreflang={docsLang}>{t.community}</a>
    </p>
  </div>
</section>

<script>
  import { mount } from '../../lib/flowshow/client';

  if (!document.documentElement.classList.contains('motion')) {
    for (const root of document.querySelectorAll<HTMLElement>('[data-flowshow]')) mount(root);
  }
</script>

<style>
  .section.flows {
    padding-top: 0;
  }

  .head {
    max-width: 880px;
  }

  .line {
    display: block;
  }

  .lead {
    margin: 20px 0 0;
  }

  .show {
    position: relative;
    margin: clamp(32px, 4vw, 48px) 0 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    padding: clamp(10px, 2vw, 22px);
    background: var(--term);
  }

  .stage :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .stage :global(.fs-tall) {
    display: none;
  }

  @media (max-width: 999px) {
    .stage :global(.fs-wide) {
      display: none;
    }

    .stage :global(.fs-tall) {
      display: block;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  .toggle {
    margin-left: auto;
    flex: none;
  }

  :global(html:not(.js)) .toggle,
  [data-still] .toggle {
    display: none;
  }

  .toggle:focus-visible {
    outline: 2px solid #74a3ff;
    outline-offset: 2px;
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--term-line);
    background: var(--term-bar);
    color: #c0c4d6;
    font-size: 15px;
  }

  .mood {
    flex: none;
    width: 1.4em;
    text-align: center;
    font-family: var(--font-mono);
  }

  .mood .s {
    display: none;
  }

  [data-mood='working'] .mood .working {
    display: inline;
    color: #f5d76e;
  }

  [data-mood='waiting'] .mood .waiting {
    display: inline;
    color: #ff8700;
  }

  [data-mood='done'] .mood .done {
    display: inline;
    color: #58e6a0;
  }

  .say {
    display: grid;
    min-width: 0;
  }

  .say > span {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }

  .say > :global(.on) {
    opacity: 1;
    transform: none;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px clamp(32px, 5vw, 80px);
    max-width: 1080px;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-left: 18px;
    border-left: 3px solid var(--brand);
  }

  .points b {
    font-stretch: var(--wide);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 720;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .points span {
    max-width: 52ch;
    color: var(--text-2);
    font-size: 16.5px;
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: clamp(32px, 4vw, 44px) 0 0;
  }

  .more {
    color: var(--brand-ink);
    font-weight: 620;
    font-size: 16px;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  :global(.motion) .section.flows {
    padding-top: clamp(40px, 8vh, 96px);
    padding-bottom: 0;
    scroll-margin-top: -34lvh;
  }

  :global(.motion) .rest {
    position: relative;
    max-width: none;
    padding-top: 1px;
    padding-bottom: clamp(80px, 10vw, 144px);
  }

  :global(.motion) .rest > * {
    max-width: var(--wrap);
    margin-inline: auto;
  }

  :global(.motion) .reel {
    height: 400lvh;
    scroll-margin-top: -24lvh;
  }

  :global(.motion) .pin {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100svh;
    max-width: calc(var(--wrap) * var(--big) + var(--gutter) * 2);
    padding-top: 76px;
    padding-bottom: 20px;
    overflow: hidden;
  }

  :global(.motion) .head {
    max-width: none;
    opacity: 0;
  }

  :global(.motion) .head .h2 {
    font-size: clamp(30px, 3.6vw, calc(60px * var(--big)));
  }

  :global(.motion) .head .line {
    display: inline;
  }

  :global(.motion) .head .lead {
    max-width: 92ch;
    margin-top: clamp(10px, 1.6vh, 18px);
    font-size: clamp(15px, 1.2vw, calc(18px * var(--big)));
    line-height: 1.45;
    text-shadow:
      0 0 18px rgb(5 6 9),
      0 0 6px rgb(5 6 9);
  }

  :global(.motion) .show {
    width: min(100%, calc((100svh - 400px) * 2.44));
    min-width: min(100%, 720px);
    margin: clamp(16px, 2.6vh, 32px) auto 0;
    opacity: 0;
    box-shadow: 0 40px 110px -30px rgb(0 70 220 / 0.55);
  }

  :global(.motion) .toggle {
    display: none;
  }

  @media (max-width: 999px) {
    :global(.motion) .head .lead {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }

    :global(.motion) .show {
      width: min(100%, calc((100svh - 330px) * 0.56));
      min-width: 0;
    }

    :global(.motion) .stage {
      padding: 6px;
    }

    :global(.motion) .strip {
      padding: 8px 10px;
      font-size: 13px;
    }
  }

  @media (max-width: 720px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
