---
import Demo from './Demo.astro';
import InstallBox from './InstallBox.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/usecornercase/cornercase-terminal';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="wrap top">
    <h1 id="hero-title">
      <span class="line">The fastest way to run</span>
      <span class="line accent">agents in parallel.<span class="caret" aria-hidden="true"></span></span>
    </h1>
    <p class="pitch">
      Every agent in its own corner. Everything a click away. And when you close the terminal, they keep working.
    </p>
  </div>

  <div class="stage" id="demo">
    <Demo />
  </div>

  <div class="wrap get">
    <InstallBox id="install" />
    <p class="meta">
      Linux &amp; macOS · <a href={repo}>free and open source</a> · <a href={`${base}/docs/`}>docs</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(36px, 5vw, 72px);
    padding-bottom: clamp(16px, 2.5vw, 32px);
    isolation: isolate;
  }

  .backdrop {
    position: absolute;
    inset: -120px 0 0;
    z-index: -1;
    background:
      radial-gradient(600px 380px at 12% 8%, rgb(135 95 255 / 0.22), transparent 70%),
      radial-gradient(700px 420px at 92% 30%, rgb(69 217 232 / 0.09), transparent 70%),
      radial-gradient(900px 500px at 50% 78%, rgb(135 95 255 / 0.16), transparent 70%);
    pointer-events: none;
  }

  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.075) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 30%, transparent 75%);
  }

  .top {
    display: grid;
    justify-items: center;
    gap: clamp(20px, 2.4vw, 30px);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 780;
    font-size: clamp(30px, 8.2vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 96;
  }

  .line {
    display: block;
  }

  .accent {
    color: transparent;
    background: linear-gradient(100deg, var(--purple-2) 10%, #d8cbff 55%, var(--cyan) 110%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .caret {
    display: inline-block;
    width: 0.36em;
    height: 0.74em;
    margin-left: 0.08em;
    vertical-align: -0.03em;
    background: var(--cyan);
    border-radius: 2px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .pitch {
    margin: 0;
    max-width: 680px;
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: balance;
  }

  .pitch strong {
    color: var(--text);
    font-weight: 600;
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: calc(1480px + var(--gutter) * 2);
    margin: clamp(32px, 4vw, 52px) auto 0;
    padding-inline: var(--gutter);
  }

  .get {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-top: clamp(36px, 4.5vw, 56px);
  }

  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--text-3);
    text-align: center;
  }

  .meta a {
    color: var(--text-2);
    text-underline-offset: 3px;
    text-decoration-color: rgb(168 141 255 / 0.5);
  }

  .meta a:hover {
    color: var(--text);
  }
</style>
