---
import { words } from '../../i18n';
import InstallBox from './InstallBox.astro';
import Snapshot from './Snapshot.astro';

const t = words(Astro.url);
const lines = t.hero.title;
const longest = Math.max(...lines.map((line) => [...line].length));
---

<section class="hero" id="top" data-section="hero" aria-labelledby="hero-title" style={`--n: ${longest}`}>
  <div class="pin">
    <h1 id="hero-title" aria-label={lines.join(' ')} data-hero-title>
      {
        lines.map((line, n) => (
          <>
          {n > 0 && ' '}
          <span class="line" aria-hidden="true">
            {line.split(' ').map((word, i) => (
              <>
                {i > 0 && ' '}
                <span class="word">
                  {[...word].map((ch) => (
                    <span class="ch" data-ch>
                      {ch}
                    </span>
                  ))}
                </span>
              </>
            ))}
          </span>
          </>
        ))
      }
    </h1>
    <p class="pitch" data-hero-rise>{t.hero.pitch}</p>
    <div class="get" data-hero-rise>
      <InstallBox id="install" />
    </div>
    <p class="strip" data-hero-rise>{t.hero.strip}</p>
    <div class="still">
      <Snapshot scene="poster" label={t.demo.label} class="still-wide" />
      <Snapshot scene="poster-compact" label={t.demo.compactLabel} class="still-compact" />
    </div>
  </div>
  <span class="hint" data-hero-hint aria-hidden="true"><i></i></span>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 6vw, 88px) var(--gutter) clamp(32px, 4vw, 56px);
  }

  .pin {
    display: grid;
    justify-items: center;
    gap: clamp(18px, 2.2vw, 28px);
    max-width: var(--wrap);
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: min(calc((100vw - 2 * var(--gutter)) / (var(--n) * 0.6)), 16vh, 132px);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  .word,
  .ch {
    display: inline-block;
  }

  .pitch {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .get {
    width: min(100%, 620px);
    text-align: left;
  }

  .strip {
    margin: 0;
    color: var(--text-3);
    font-size: 15px;
    font-weight: 500;
  }

  .still {
    width: 100%;
    margin-top: clamp(16px, 2vw, 28px);
    border: 1px solid #262838;
  }

  .still :global(.still-compact) {
    display: none;
  }

  .hint {
    display: none;
  }

  :global(.motion) .hero {
    height: 230lvh;
    padding: 0;
  }

  :global(.motion) .pin {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    max-width: none;
    align-content: start;
    padding: clamp(92px, 13.5vh, 136px) var(--gutter) 0;
    gap: clamp(14px, 2.3vh, 24px);
    overflow: hidden;
  }

  :global(.motion) .pin::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1700px, 136vw);
    height: 92vh;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(9 10 13 / 0.9) 34%, rgb(9 10 13 / 0.62) 64%, transparent);
    pointer-events: none;
    transition: opacity 1.2s ease-out;
  }

  :global(.intro) .pin::before {
    opacity: 0;
  }

  :global(.motion) .pin > * {
    position: relative;
  }

  :global(.motion) .still {
    display: none;
  }

  :global(.motion) .get :global(#install) {
    scroll-margin-top: 100000px;
  }

  :global(.motion) h1 {
    font-stretch: 112%;
    font-size: min(calc((100vw - 2 * var(--gutter)) / (var(--n) * 0.59)), 17vh, calc(190px * var(--big)));
    line-height: 0.95;
  }

  :global(.motion) .ch {
    position: relative;
    will-change: transform, opacity;
  }

  :global(.motion) .ch::before {
    content: '';
    position: absolute;
    inset: 14% 2% 6%;
    background: var(--brand);
    opacity: var(--blk, 0);
    pointer-events: none;
  }

  :global(.intro) .ch {
    opacity: 0;
  }

  :global(.motion) [data-hero-rise] {
    transition:
      opacity 0.9s var(--expo) 0.2s,
      transform 1.1s var(--expo) 0.2s;
  }

  :global(.motion) .pitch {
    font-size: clamp(17px, 1.45vw, calc(21px * var(--big)));
  }

  :global(.motion) .get {
    zoom: var(--big);
    transition-delay: 0.3s;
  }

  :global(.motion) .strip {
    font-size: calc(15px * var(--big));
    transition-delay: 0.4s;
    text-shadow:
      0 0 18px rgb(5 6 9),
      0 0 6px rgb(5 6 9);
  }

  :global(.intro) [data-hero-rise] {
    opacity: 0;
    transform: translateY(26px);
  }

  :global(.motion) .hint {
    display: block;
    position: fixed;
    left: 50%;
    bottom: 22px;
    z-index: 15;
    width: 22px;
    height: 36px;
    margin-left: -11px;
    border: 1.5px solid rgb(255 255 255 / 0.36);
    background: rgb(10 12 16 / 0.5);
    transition: opacity 0.5s;
  }

  :global(.intro) .hint {
    opacity: 0;
  }

  .hint i {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 7px;
    margin-left: -2px;
    background: var(--text);
    animation: hint 1.7s var(--expo) infinite;
  }

  @keyframes hint {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 700px) {
    .still :global(.still-wide) {
      display: none;
    }

    .still :global(.still-compact) {
      display: block;
    }

    h1,
    :global(.motion) h1 {
      font-size: clamp(34px, 11.4vw, 60px);
      letter-spacing: -0.03em;
    }

    .line {
      white-space: normal;
      text-wrap: balance;
    }

    :global(.motion) .pin {
      padding-top: 88px;
    }

    .pitch {
      font-size: 16.5px;
    }

    :global(.motion) .hint {
      display: none;
    }
  }
</style>
