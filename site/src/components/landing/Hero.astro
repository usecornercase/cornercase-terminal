---
import { words } from '../../i18n';
import Demo from './Demo.astro';
import InstallBox from './InstallBox.astro';

const t = words(Astro.url);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap top">
    <p class="strip">{t.hero.strip}</p>
    <h1 id="hero-title">
      <span class="line">{t.hero.title[0]}</span>{' '}<span class="line">{t.hero.title[1]}</span>
    </h1>
    <div class="get">
      <p class="pitch">{t.hero.pitch}</p>
      <InstallBox id="install" />
    </div>
  </div>

  <div class="stage" id="demo">
    <Demo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(32px, 4.5vw, 64px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .strip {
    margin: 0 0 18px;
    color: var(--text-3);
    font-size: 15px;
    font-weight: 500;
  }

  h1 {
    margin: 0;
    font-stretch: var(--wide);
    font-weight: 780;
    font-size: clamp(32px, 5.4vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .line {
    display: block;
  }

  .get {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: end;
    gap: 24px clamp(32px, 5vw, 80px);
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  .pitch {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .get :global(.install) {
    justify-self: end;
  }

  .stage {
    --g: clamp(16px, 4vw, 40px);
    position: relative;
    width: 100%;
    max-width: calc(1480px + var(--g) * 2);
    margin: clamp(36px, 4vw, 56px) auto 0;
    padding-inline: var(--g);
  }

  @media (max-width: 900px) {
    .get {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .get :global(.install) {
      justify-self: start;
    }
  }

  @media (max-width: 600px) {
    h1 {
      font-stretch: 100%;
      font-size: clamp(30px, 8.6vw, 40px);
      letter-spacing: -0.035em;
    }

    .strip {
      font-size: 14px;
      margin-bottom: 14px;
    }
  }

  @media (max-width: 359px) {
    h1 {
      font-size: 8.4vw;
    }
  }
</style>
