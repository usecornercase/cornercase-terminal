---
import { words } from '../../i18n';

interface Props {
  id?: string;
}

const { id } = Astro.props;
const t = words(Astro.url);
const ways: [string, string][] = [
  [t.install.script, 'curl -fsSL https://usecornercase.dev/install.sh | sh'],
  ['Homebrew', 'brew install usecornercase/tap/cornercase'],
];
---

<div class="install" id={id} data-install>
  <div class="ways" role="group" aria-label={t.install.label}>
    {
      ways.map(([label, command], i) => (
        <button type="button" class="way" aria-pressed={i === 0 ? 'true' : 'false'} data-command={command}>
          {label}
        </button>
      ))
    }
  </div>
  <div class="line">
    <span class="ps" aria-hidden="true">$</span>
    <code data-shown>{ways[0][1]}</code>
    <button type="button" class="copy" data-copy={ways[0][1]}>
      <span class="idle">{t.install.copy}</span><span class="done">{t.install.copied}</span>
    </button>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const shown = box.querySelector<HTMLElement>('[data-shown]');
    const copy = box.querySelector<HTMLButtonElement>('[data-copy]');
    const ways = [...box.querySelectorAll<HTMLButtonElement>('[data-command]')];
    for (const way of ways) {
      way.addEventListener('click', () => {
        ways.forEach((w) => w.setAttribute('aria-pressed', String(w === way)));
        const command = way.dataset.command ?? '';
        if (shown) shown.textContent = command;
        if (copy) copy.dataset.copy = command;
      });
    }
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        copy.classList.add('copied');
        setTimeout(() => copy.classList.remove('copied'), 1600);
      } catch {}
    });
  }
</script>

<style>
  .install {
    width: 100%;
    max-width: 620px;
  }

  .ways {
    display: flex;
    gap: 18px;
    margin-bottom: 10px;
  }

  .way {
    padding: 2px 0 4px;
    border: 0;
    background: transparent;
    color: var(--text-3);
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .way:hover {
    color: var(--text);
  }

  .way[aria-pressed='true'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  .line {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }

  .ps {
    flex: none;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 15px;
    user-select: none;
  }

  .line code {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    white-space: nowrap;
    overflow-x: auto;
  }

  .copy {
    flex: none;
    display: inline-grid;
    height: 40px;
    padding: 0 16px;
    border: 0;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font);
    font-size: 14.5px;
    font-weight: 620;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .copy:active {
    transform: translateY(1px);
  }

  .copy span {
    grid-area: 1 / 1;
    align-self: center;
  }

  .copy .done {
    visibility: hidden;
  }

  .copy:hover {
    background: var(--brand-hover);
  }

  .copy.copied {
    background: var(--text);
    color: var(--bg);
  }

  .copy.copied .idle {
    visibility: hidden;
  }

  .copy.copied .done {
    visibility: visible;
  }

  @media (max-width: 520px) {
    .line {
      flex-wrap: wrap;
      padding: 12px 12px 12px 14px;
    }

    .line code {
      flex-basis: calc(100% - 24px);
      font-size: min(12.5px, calc((100vw - 100px) / 31.5));
    }

    .copy {
      width: 100%;
    }
  }
</style>
