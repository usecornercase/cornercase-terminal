---
interface Props {
  id?: string;
}

const { id } = Astro.props;
const ways: [string, string][] = [
  ['Install script', 'curl -fsSL https://usecornercase.dev/install.sh | sh'],
  ['Homebrew', 'brew install usecornercase/tap/cornercase'],
];
---

<div class="install" id={id} data-install>
  <div class="ways" role="group" aria-label="How to install">
    {
      ways.map(([label, command], i) => (
        <button type="button" class="way" aria-pressed={i === 0 ? 'true' : 'false'} data-command={command}>
          {label}
        </button>
      ))
    }
  </div>
  <div class="line">
    <span class="ps" aria-hidden="true">$</span>
    <code data-shown>{ways[0][1]}</code>
    <button type="button" class="copy" data-copy={ways[0][1]}>
      <span class="idle">copy</span><span class="done">copied</span>
    </button>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const shown = box.querySelector<HTMLElement>('[data-shown]');
    const copy = box.querySelector<HTMLButtonElement>('[data-copy]');
    const ways = [...box.querySelectorAll<HTMLButtonElement>('[data-command]')];
    for (const way of ways) {
      way.addEventListener('click', () => {
        ways.forEach((w) => w.setAttribute('aria-pressed', String(w === way)));
        const command = way.dataset.command ?? '';
        if (shown) shown.textContent = command;
        if (copy) copy.dataset.copy = command;
      });
    }
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        copy.classList.add('copied');
        setTimeout(() => copy.classList.remove('copied'), 1600);
      } catch {}
    });
  }
</script>

<style>
  .install {
    width: 100%;
    max-width: 560px;
  }

  .ways {
    display: flex;
    gap: 4px;
    margin-bottom: 8px;
  }

  .way {
    padding: 4px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text-3);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .way:hover {
    color: var(--text);
  }

  .way[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.07);
    color: var(--text);
  }

  .line {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 8px 8px 8px 18px;
    border-radius: 13px;
    border: 1px solid rgb(135 95 255 / 0.45);
    background: linear-gradient(180deg, rgb(135 95 255 / 0.1), rgb(135 95 255 / 0.03)), var(--term);
    box-shadow: 0 18px 50px -24px rgb(135 95 255 / 0.65);
  }

  .ps {
    flex: none;
    color: var(--purple-2);
    font-family: var(--font-mono);
    font-size: 15px;
    user-select: none;
  }

  .line code {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .copy {
    flex: none;
    display: inline-grid;
    height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 9px;
    background: #7552f2;
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .copy span {
    grid-area: 1 / 1;
    align-self: center;
  }

  .copy .done {
    visibility: hidden;
  }

  .copy:hover {
    background: #6d48f5;
  }

  .copy.copied {
    background: var(--green);
    color: #07060b;
  }

  .copy.copied .idle {
    visibility: hidden;
  }

  .copy.copied .done {
    visibility: visible;
  }

  @media (max-width: 520px) {
    .line {
      flex-wrap: wrap;
      padding: 12px 12px 12px 14px;
    }

    .line code {
      flex-basis: calc(100% - 24px);
      font-size: 12.5px;
      overflow-wrap: normal;
    }

    .copy {
      width: 100%;
    }
  }
</style>
