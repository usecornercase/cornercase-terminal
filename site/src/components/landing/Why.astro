---
import { localeOf, words } from '../../i18n';
import Rich from './Rich.astro';
import Mark from './Mark.astro';
import Snapshot from './Snapshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const procs = ['claude', 'codex', 'claude', 'npm run dev'];
const t = words(Astro.url).why;
const [start, parallel, review, leave] = t.steps;
---

<section class="section why" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="h2" id="why-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    <ol class="steps">
      <li class="step reveal">
        <div class="text">
          <h3>{start.title}</h3>
          <p><Rich text={start.text} /></p>
          <a class="more" href={docs('guides/issues-and-agents/')} hreflang={docsLang}>{start.more}</a>
        </div>
        <Snapshot scene="issue" label={start.label} class="shot" />
      </li>

      <li class="step reveal flip">
        <div class="text">
          <h3>{parallel.title}</h3>
          <p><Rich text={parallel.text} /></p>
          <a class="more" href={docs('reference/agents/')} hreflang={docsLang}>{parallel.more}</a>
        </div>
        <Snapshot scene="status" label={parallel.label} class="shot" />
      </li>

      <li class="step reveal half">
        <div class="text">
          <h3>{review.title}</h3>
          <p><Rich text={review.text} /></p>
          <a class="more" href={docs('guides/changes/')} hreflang={docsLang}>{review.more}</a>
        </div>
        <Snapshot scene="changes" label={review.label} class="shot" />
      </li>

      <li class="step reveal half" style="--i: 1">
        <div class="text">
          <h3>{leave.title}</h3>
          <p><Rich text={leave.text} /></p>
          <a class="more" href={docs('guides/sessions/')} hreflang={docsLang}>{leave.more}</a>
        </div>
        <figure class="diagram" aria-labelledby="diagram-caption">
          <div class="client">
            <span class="title">{t.diagram.terminal}</span>
            <span class="state on">{t.diagram.attached}</span>
            <span class="state off">{t.diagram.closed}</span>
          </div>
          <svg class="wire" viewBox="0 0 20 48" preserveAspectRatio="none" aria-hidden="true"><path d="M10 0V48"></path></svg>
          <div class="server">
            <span class="title">
              <Mark size={12} />
              {t.diagram.server}
            </span>
            <ul>
              {procs.map((p) => <li><i />{p}</li>)}
            </ul>
          </div>
          <figcaption id="diagram-caption" class="sr-only">{t.diagram.caption}</figcaption>
        </figure>
      </li>
    </ol>

    <div class="band reveal">
      <div class="text">
        <h3>{t.band.title}</h3>
        <p><Rich text={t.band.text} /></p>
        <a class="more" href={docs('guides/scripts-and-agents/')} hreflang={docsLang}>{t.band.more}</a>
      </div>
      <figure class="transcript">
        <figcaption>{t.band.session}</figcaption>
        <pre><span class="d">$</span> cornercase start codex --worktree feat/gift-cards \
    --prompt 'Add gift cards to the checkout'
<span class="d">12</span>
<span class="d">$</span> cornercase wait --pane 12 --timeout 900
<span class="d">idle</span>
<span class="d">$</span> cornercase read --pane 12 --last-message
<span class="g">Done.</span> Gift cards work in the checkout: a GiftCard with a
balance is applied after coupons and before tax.</pre>
      </figure>
    </div>
  </div>
</section>

<style>
  .section.why {
    padding-top: clamp(80px, 9vw, 136px);
  }

  .head {
    max-width: 920px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(72px, 9vw, 136px) clamp(28px, 4.5vw, 72px);
    margin: clamp(48px, 6vw, 88px) 0 0;
    padding: 0;
    list-style: none;
  }

  .step,
  .band {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4.5vw, 72px);
    align-items: center;
  }

  .step:not(.half) {
    grid-column: 1 / -1;
  }

  .step.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .step.flip .text {
    order: 1;
  }

  .step.half {
    grid-row: span 2;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: subgrid;
    align-items: start;
    gap: clamp(24px, 3vw, 36px);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-stretch: var(--wide);
    font-size: clamp(26px, 2.7vw, 40px);
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .text p {
    margin: 0;
    max-width: 50ch;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .more {
    align-self: flex-start;
    color: var(--brand-ink);
    font-weight: 620;
    font-size: 16px;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .diagram {
    display: grid;
    justify-items: center;
    margin: 0;
    padding: clamp(24px, 3vw, 40px) clamp(16px, 2vw, 28px);
    background: var(--term);
    color: #e4e7f2;
  }

  .client {
    display: grid;
    justify-items: center;
    gap: 4px;
    width: min(100%, 240px);
    padding: 12px;
    border: 1px solid #3a3e52;
    background: #111219;
    animation: detach 8s ease-in-out infinite;
  }

  .title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: #e4e7f2;
  }

  .title :global(.mark .k) {
    fill: #e4e7f2;
  }

  .title :global(.mark .c) {
    fill: #74a3ff;
  }

  .state {
    grid-area: 2 / 1;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
  }

  .state.on {
    color: #58e6a0;
    animation: show 8s infinite;
  }

  .state.off {
    color: #f5d76e;
    opacity: 0;
    animation: hide 8s infinite;
  }

  .wire {
    display: block;
    width: 20px;
    height: 44px;
    overflow: visible;
  }

  .wire path {
    fill: none;
    stroke: #74a3ff;
    stroke-width: 2;
    stroke-dasharray: 5 6;
    vector-effect: non-scaling-stroke;
    animation:
      flow 1.2s linear infinite,
      cut 8s ease-in-out infinite;
  }

  .server {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 12px;
    border: 2px solid #3d6dff;
    background: #13141c;
  }

  .server ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .server li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border: 1px solid #2c2f40;
    background: var(--term);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: #e4e7f2;
    white-space: nowrap;
  }

  .server li i {
    width: 7px;
    height: 7px;
    background: #58e6a0;
    animation: alive 1.8s ease-in-out infinite;
  }

  .server li:nth-child(2) i {
    animation-delay: 0.45s;
  }

  .server li:nth-child(3) i {
    animation-delay: 0.9s;
  }

  .server li:nth-child(4) i {
    animation-delay: 1.35s;
  }

  @keyframes detach {
    0%,
    35%,
    85%,
    100% {
      opacity: 1;
    }
    45%,
    75% {
      opacity: 0.3;
    }
  }

  @keyframes show {
    0%,
    38%,
    82%,
    100% {
      opacity: 1;
    }
    42%,
    78% {
      opacity: 0;
    }
  }

  @keyframes hide {
    0%,
    38%,
    82%,
    100% {
      opacity: 0;
    }
    42%,
    78% {
      opacity: 1;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -22;
    }
  }

  @keyframes cut {
    0%,
    38%,
    82%,
    100% {
      opacity: 0.9;
    }
    42%,
    78% {
      opacity: 0.08;
    }
  }

  @keyframes alive {
    50% {
      opacity: 0.35;
    }
  }

  .band {
    margin-top: clamp(80px, 10vw, 152px);
  }

  .transcript {
    margin: 0;
    background: var(--term);
    color: #e4e7f2;
    overflow: hidden;
  }

  .transcript figcaption {
    padding: 10px 16px;
    border-bottom: 1px solid var(--term-line);
    background: var(--term-bar);
    font-size: 13.5px;
    color: #9aa1bd;
  }

  .transcript pre {
    margin: 0;
    padding: 18px 20px 20px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .transcript .d {
    color: #8088a6;
  }

  .transcript .g {
    color: #58e6a0;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step,
    .step.flip,
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .step.flip .text {
      order: 0;
    }

    .text p {
      max-width: none;
    }
  }
</style>
