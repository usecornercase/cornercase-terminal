---
import { localeOf, words } from '../../i18n';
import Rich from './Rich.astro';
import Snapshot from './Snapshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const procs = ['claude', 'codex', 'claude', 'npm run dev'];
const t = words(Astro.url).why;
const [start, parallel, review, leave] = t.steps;
---

<section class="section why" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 class="h2" id="why-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>

    <ol class="steps">
      <li class="step reveal">
        <div class="text">
          <span class="num">{start.num}</span>
          <h3>{start.title}</h3>
          <p><Rich text={start.text} /></p>
          <a class="more" href={docs('guides/issues-and-agents/')} hreflang={docsLang}>{start.more}</a>
        </div>
        <Snapshot scene="issue" label={start.label} class="shot" />
      </li>

      <li class="step reveal flip">
        <div class="text">
          <span class="num">{parallel.num}</span>
          <h3>{parallel.title}</h3>
          <p><Rich text={parallel.text} /></p>
          <a class="more" href={docs('reference/agents/')} hreflang={docsLang}>{parallel.more}</a>
        </div>
        <Snapshot scene="status" label={parallel.label} class="shot" />
      </li>

      <li class="step reveal">
        <div class="text">
          <span class="num">{review.num}</span>
          <h3>{review.title}</h3>
          <p><Rich text={review.text} /></p>
          <a class="more" href={docs('guides/changes/')} hreflang={docsLang}>{review.more}</a>
        </div>
        <Snapshot scene="changes" label={review.label} class="shot" />
      </li>

      <li class="step reveal flip">
        <div class="text">
          <span class="num">{leave.num}</span>
          <h3>{leave.title}</h3>
          <p><Rich text={leave.text} /></p>
          <a class="more" href={docs('guides/sessions/')} hreflang={docsLang}>{leave.more}</a>
        </div>
        <figure class="diagram" aria-labelledby="diagram-caption">
          <div class="client">
            <span class="title">{t.diagram.terminal}</span>
            <span class="state on">{t.diagram.attached}</span>
            <span class="state off">{t.diagram.closed}</span>
          </div>
          <svg class="wire" viewBox="0 0 20 48" preserveAspectRatio="none" aria-hidden="true"><path d="M10 0V48"></path></svg>
          <div class="server">
            <span class="title">
              <svg viewBox="0 0 4 4" aria-hidden="true" shape-rendering="crispEdges"><path d="M1 0h3v1H1zM0 1h1v3H0z"></path></svg>
              {t.diagram.server}
            </span>
            <ul>
              {procs.map((p) => <li><i />{p}</li>)}
            </ul>
          </div>
          <figcaption id="diagram-caption" class="sr-only">{t.diagram.caption}</figcaption>
        </figure>
      </li>
    </ol>

    <div class="band reveal">
      <div class="text">
        <span class="num">{t.band.num}</span>
        <h3>{t.band.title}</h3>
        <p><Rich text={t.band.text} /></p>
        <a class="more" href={docs('guides/scripts-and-agents/')} hreflang={docsLang}>{t.band.more}</a>
      </div>
      <figure class="transcript">
        <figcaption>{t.band.session}</figcaption>
        <pre><span class="d">$</span> cornercase start codex --worktree feat/gift-cards \
    --prompt 'Add gift cards to the checkout'
<span class="d">12</span>
<span class="d">$</span> cornercase wait --pane 12 --timeout 900
<span class="d">idle</span>
<span class="d">$</span> cornercase read --pane 12 --last-message
<span class="g">Done.</span> Gift cards work in the checkout: a GiftCard with a
balance is applied after coupons and before tax.</pre>
      </figure>
    </div>
  </div>
</section>

<style>
  .section.why {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .h2 {
    max-width: 22ch;
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .lead {
    margin: 14px 0 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: 17px;
  }

  .steps {
    margin: clamp(28px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .step,
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(36px, 5vw, 60px);
    border-top: 1px solid var(--line);
  }

  .step:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .step.flip .text {
    order: 1;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .text p {
    margin: 0;
    max-width: 46ch;
    color: var(--text-2);
    font-size: 16.5px;
    line-height: 1.6;
  }

  .more {
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .more:hover {
    color: var(--purple-3);
  }

  .shot {
    box-shadow: 0 20px 50px -30px rgb(0 0 0 / 0.9);
  }

  .diagram {
    display: grid;
    justify-items: center;
    margin: 0;
    padding: 18px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: radial-gradient(70% 60% at 50% 70%, rgb(135 95 255 / 0.12), transparent 75%), var(--term);
  }

  .client {
    display: grid;
    justify-items: center;
    gap: 4px;
    width: min(100%, 230px);
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    animation: detach 8s ease-in-out infinite;
  }

  .title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text);
  }

  .title svg {
    width: 12px;
    height: 12px;
    fill: var(--purple);
  }

  .state {
    grid-area: 2 / 1;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }

  .state.on {
    color: var(--green);
    animation: show 8s infinite;
  }

  .state.off {
    color: var(--yellow);
    opacity: 0;
    animation: hide 8s infinite;
  }

  .wire {
    display: block;
    width: 20px;
    height: 40px;
    overflow: visible;
  }

  .wire path {
    fill: none;
    stroke: var(--purple);
    stroke-width: 2;
    stroke-dasharray: 5 6;
    vector-effect: non-scaling-stroke;
    animation:
      flow 1.2s linear infinite,
      cut 8s ease-in-out infinite;
  }

  .server {
    display: grid;
    justify-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 12px;
    border-radius: 12px;
    border: 1px solid rgb(135 95 255 / 0.55);
    background: linear-gradient(180deg, rgb(135 95 255 / 0.14), rgb(135 95 255 / 0.04)), var(--panel);
    box-shadow: 0 0 50px -20px rgb(135 95 255 / 0.6);
  }

  .server ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .server li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 9px;
    border-radius: 7px;
    border: 1px solid var(--line-2);
    background: var(--term);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
    white-space: nowrap;
  }

  .server li i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: alive 1.8s ease-in-out infinite;
  }

  .server li:nth-child(2) i {
    animation-delay: 0.45s;
  }

  .server li:nth-child(3) i {
    animation-delay: 0.9s;
  }

  .server li:nth-child(4) i {
    animation-delay: 1.35s;
  }

  @keyframes detach {
    0%,
    35%,
    85%,
    100% {
      opacity: 1;
      filter: none;
    }
    45%,
    75% {
      opacity: 0.35;
      filter: grayscale(1);
    }
  }

  @keyframes show {
    0%,
    38%,
    82%,
    100% {
      opacity: 1;
    }
    42%,
    78% {
      opacity: 0;
    }
  }

  @keyframes hide {
    0%,
    38%,
    82%,
    100% {
      opacity: 0;
    }
    42%,
    78% {
      opacity: 1;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -22;
    }
  }

  @keyframes cut {
    0%,
    38%,
    82%,
    100% {
      opacity: 0.85;
    }
    42%,
    78% {
      opacity: 0.08;
    }
  }

  @keyframes alive {
    50% {
      opacity: 0.3;
    }
  }

  .transcript {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--term);
    overflow: hidden;
  }

  .transcript figcaption {
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-3);
  }

  .transcript pre {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .transcript .d {
    color: var(--text-3);
  }

  .transcript .g {
    color: var(--green);
  }

  @media (max-width: 820px) {
    .step,
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .step.flip .text {
      order: 0;
    }

    .text p {
      max-width: none;
    }
  }
</style>
