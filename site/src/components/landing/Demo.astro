---
import Snapshot from './Snapshot.astro';
import { PICKER, themes } from '../../lib/term/palette';

const label =
  "A live simulation of cornercase: the work and personal groups with their seven projects on top, where orders-api needs you and blog's agent is done; the three worktrees of web-shop below, feat/dark-mode, feat/gift-cards and fix/empty-address, each with a Claude working; the conversation on dark mode in the middle, with the paths it names as links, and the TODO list on the right.";
const compactLabel =
  "A live simulation of cornercase in its compact layout: the bar with web-shop, feat/dark-mode and the agent's tab, and the conversation on dark mode in the pane.";
---

<div class="demo" data-demo data-state="poster">
  <div class="frame">
    <div class="marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="window">
      <div class="window-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="window-title">cornercase — ~/code/web-shop</span>
        <span class="themes" role="group" aria-label="Terminal theme">
          {
            PICKER.map(([id, name]) => (
              <button type="button" class="swatch" data-palette={id} title={name} aria-label={name} aria-pressed={id === 'tokyo' ? 'true' : 'false'} style={`--sw: ${themes[id].background}; --sw-2: ${themes[id].overrides[99] ?? themes[id].ansi[5]}`} />
            ))
          }
        </span>
        <span class="live" aria-hidden="true"><i></i>Live simulation</span>
      </div>
      <div class="screen">
        <Snapshot scene="poster" label={label} bare class="poster poster-wide poster-177" />
        <Snapshot scene="poster-190" label={label} bare class="poster poster-wide poster-190" />
        <Snapshot scene="poster-202" label={label} bare class="poster poster-wide poster-202" />
        <Snapshot scene="poster-220" label={label} bare class="poster poster-wide poster-220" />
        <Snapshot scene="poster-102" label={label} bare class="poster poster-wide poster-102" />
        <Snapshot scene="poster-compact" label={compactLabel} bare class="poster poster-compact" />
        <canvas role="img" aria-label={label}></canvas>
        <textarea
          class="keys"
          tabindex="-1"
          aria-label="Keyboard input for the demo: what you type goes to the active pane"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"></textarea>
        <div class="play">
          <button type="button" class="play-button" data-play>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1.5v11.6l3.1-2.9 2 4.5 2-.9-2-4.4h4.3z" fill="currentColor" stroke="currentColor" stroke-width="0.8" stroke-linejoin="round"></path></svg>
            Try cornercase live
          </button>
          <p class="play-hint">A real simulation, not a video: click around, type in a shell, start an agent.</p>
        </div>
        <div class="spot" hidden aria-hidden="true"></div>
        <div class="lapse" hidden aria-hidden="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3l6 5-6 5zM8 3l6 5-6 5z" fill="currentColor"></path></svg>
          <span data-lapse></span>
        </div>
        <div class="pointer" hidden aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2.5v17.2l4.6-4.4 2.9 6.6 3-1.3-2.9-6.5h6.4z" fill="#fff" stroke="#0e0d14" stroke-width="1.4" stroke-linejoin="round"></path></svg>
        </div>
      </div>
      <div class="strip">
        <p class="caption" data-caption aria-live="polite"></p>
        <button class="replay" type="button" data-replay hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3M3.5 2.5v3h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span data-replay-label>watch again</span>
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  import { boot } from '../../lib/demo/boot';
  boot();
</script>

<style>
  .demo {
    position: relative;
  }

  .frame {
    position: relative;
  }

  .screen {
    position: relative;
    padding: 10px 12px 12px;
    min-height: calc(46 * 6.6px * 2.08 + 22px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
  }

  .demo[data-state='poster'] .screen {
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .screen :global(.poster) {
    position: absolute;
    inset: 10px 12px auto;
    display: none;
    cursor: pointer;
  }

  .demo[data-state='poster'] .screen :global(.poster-177) {
    display: block;
  }

  @media (min-width: 1281px) {
    .demo[data-state='poster'] .screen :global(.poster-177) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-190) {
      display: block;
    }
  }

  @media (min-width: 1367px) {
    .demo[data-state='poster'] .screen :global(.poster-190) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-202) {
      display: block;
    }
  }

  @media (min-width: 1446px) {
    .demo[data-state='poster'] .screen :global(.poster-202) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-220) {
      display: block;
    }
  }

  .demo[data-state='poster'] canvas {
    visibility: hidden;
  }

  .demo:not([data-state='poster']) .play,
  .demo[data-state='poster'] .strip {
    display: none;
  }

  canvas {
    display: block;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .keys {
    position: absolute;
    left: 12px;
    top: 10px;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    resize: none;
    font-size: 16px;
    caret-color: transparent;
    pointer-events: none;
  }

  .play {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: radial-gradient(ellipse at center, rgb(7 6 11 / 0.6), rgb(7 6 11 / 0.18));
    pointer-events: none;
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border: 0;
    border-radius: 999px;
    background: var(--purple);
    color: #fff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 10px 30px -10px rgb(135 95 255 / 0.8);
  }

  .play-button:hover {
    background: var(--purple-2);
  }

  .play-button svg {
    width: 14px;
    height: 14px;
  }

  .play-hint {
    max-width: 32ch;
    margin: 0;
    text-align: center;
    text-wrap: balance;
    font-size: 14px;
    color: var(--text-2);
    text-shadow: 0 1px 6px rgb(7 6 11 / 0.9);
  }

  .strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 14px;
    border-top: 1px solid var(--line);
    background: var(--panel);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .caption {
    margin: 0;
    min-width: 0;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--text);
    text-wrap: pretty;
  }

  .caption::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 1em;
    margin-right: 10px;
    vertical-align: -0.14em;
    background: var(--cyan);
  }

  .caption :global(code) {
    font-size: 0.85em;
  }

  .replay {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid rgb(69 217 232 / 0.45);
    border-radius: 999px;
    background: transparent;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .replay:hover {
    background: var(--cyan);
    color: #07060b;
  }

  .replay svg {
    width: 13px;
    height: 13px;
  }

  .spot {
    position: absolute;
    z-index: 2;
    border-radius: 6px;
    outline: 1px solid rgb(69 217 232 / 0.7);
    box-shadow: 0 0 0 200vmax rgb(7 6 11 / 0.62);
    pointer-events: none;
    transition:
      left 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      top 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      width 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      height 0.45s cubic-bezier(0.3, 0.7, 0.2, 1);
    animation: spot-in 0.35s ease-out;
  }

  @keyframes spot-in {
    from {
      opacity: 0;
    }
  }

  .lapse {
    position: absolute;
    z-index: 4;
    right: 22px;
    top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgb(245 215 110 / 0.5);
    background: rgb(20 18 30 / 0.92);
    color: var(--yellow);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    animation: spot-in 0.3s ease-out;
  }

  .lapse svg {
    width: 14px;
    height: 14px;
    animation: lapse 0.7s linear infinite;
  }

  @keyframes lapse {
    50% {
      opacity: 0.35;
    }
  }

  .themes {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-right: 14px;
  }

  .swatch {
    width: 14px;
    height: 14px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 50%;
    background: linear-gradient(135deg, var(--sw) 0 58%, var(--sw-2) 58% 100%);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .swatch:hover {
    transform: scale(1.18);
  }

  .swatch[aria-pressed='true'] {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--green);
    letter-spacing: 0.04em;
  }

  .live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgb(88 230 160 / 0.6);
    animation: pulse 2.2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(88 230 160 / 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgb(88 230 160 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(88 230 160 / 0);
    }
  }

  .pointer {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 0;
    height: 0;
    pointer-events: none;
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
    filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.55));
  }

  .pointer svg {
    position: absolute;
    left: -3px;
    top: -2px;
  }

  .pointer::after {
    content: '';
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--cyan);
    opacity: 0;
    transform: scale(0.3);
  }

  .pointer.right::after {
    border-color: var(--purple-2);
  }

  .pointer.tap::after {
    animation: tap 0.5s ease-out;
  }

  @keyframes tap {
    0% {
      opacity: 0.9;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  @media (max-width: 899px) {
    .screen {
      min-height: calc(32 * 7.8px * 2.08 + 22px);
      padding: 8px;
    }

    .keys {
      left: 8px;
      top: 8px;
    }

    .screen :global(.poster) {
      inset: 8px 8px auto;
    }

    .demo[data-state='poster'] .screen :global(.poster-177) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-102) {
      display: block;
    }

    .lapse {
      right: 14px;
      top: 12px;
      font-size: 12.5px;
    }

    .marks {
      display: none;
    }
  }

  @media (max-width: 559px) {
    .screen {
      min-height: calc(34 * 7.4px * 2.08 + 16px);
    }

    .demo[data-state='poster'] .screen :global(.poster-wide) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-compact) {
      display: block;
    }

    .play-hint {
      padding: 0 24px;
      text-align: center;
    }

    .strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .themes {
      display: none;
    }
  }
</style>
