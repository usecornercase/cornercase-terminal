---
import { localeOf, words } from '../../i18n';
import { DEMO } from '../../i18n/demo';
import Snapshot from './Snapshot.astro';
import { PICKER, themes } from '../../lib/term/palette';

const locale = localeOf(Astro.url);
const t = words(Astro.url).demo;
const tour = DEMO[locale].tour;
---

<div class="demo" data-demo data-state="poster" data-locale={locale}>
  <div class="frame">
    <div class="window">
      <div class="window-bar">
        <span class="window-title">cornercase · ~/code/web-shop</span>
        <span class="themes" role="group" aria-label={t.themes}>
          {
            PICKER.map(([id, name]) => (
              <button type="button" class="swatch" data-palette={id} title={name} aria-label={name} aria-pressed={id === 'tokyo' ? 'true' : 'false'} style={`--sw: ${themes[id].background}; --sw-2: ${themes[id].overrides[99] ?? themes[id].ansi[5]}`} />
            ))
          }
        </span>
        <span class="live" aria-hidden="true">{t.live}</span>
      </div>
      <div class="screen">
        <Snapshot scene="poster" label={t.label} bare class="poster poster-wide poster-177" />
        <Snapshot scene="poster-190" label={t.label} bare class="poster poster-wide poster-190" />
        <Snapshot scene="poster-202" label={t.label} bare class="poster poster-wide poster-202" />
        <Snapshot scene="poster-220" label={t.label} bare class="poster poster-wide poster-220" />
        <Snapshot scene="poster-102" label={t.label} bare class="poster poster-wide poster-102" />
        <Snapshot scene="poster-compact" label={t.compactLabel} bare class="poster poster-compact" />
        <canvas role="img" aria-label={t.label}></canvas>
        <textarea
          class="keys"
          tabindex="-1"
          aria-label={t.keys}
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"></textarea>
        <div class="play">
          <div class="play-card">
          <button type="button" class="play-button" data-play>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1.5v11.6l3.1-2.9 2 4.5 2-.9-2-4.4h4.3z" fill="currentColor" stroke="currentColor" stroke-width="0.8" stroke-linejoin="round"></path></svg>
            {t.play}
          </button>
          <p class="play-hint">{t.hint}</p>
          </div>
        </div>
        <div class="spot" hidden aria-hidden="true"></div>
        <div class="lapse" hidden aria-hidden="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3l6 5-6 5zM8 3l6 5-6 5z" fill="currentColor"></path></svg>
          <span data-lapse></span>
        </div>
        <div class="pointer" hidden aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2.5v17.2l4.6-4.4 2.9 6.6 3-1.3-2.9-6.5h6.4z" fill="#f7f8fa" stroke="#0c0e11" stroke-width="1.4" stroke-linejoin="round"></path></svg>
        </div>
      </div>
      <div class="strip">
        <p class="caption" data-caption aria-live="polite"></p>
        <button class="replay" type="button" data-replay hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3M3.5 2.5v3h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span data-replay-label>{tour.again}</span>
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  import { boot } from '../../lib/demo/boot';
  boot();
</script>

<style>
  .demo {
    position: relative;
  }

  .frame {
    position: relative;
  }

  .frame::before,
  .frame::after {
    content: '';
    position: absolute;
    z-index: 1;
    background: var(--brand);
    pointer-events: none;
  }

  .frame::before {
    left: 0;
    top: -14px;
    width: clamp(120px, 14vw, 220px);
    height: 6px;
  }

  .frame::after {
    left: -14px;
    top: 0;
    width: 6px;
    height: clamp(120px, 14vw, 220px);
  }

  .screen {
    position: relative;
    padding: 10px 12px 12px;
    min-height: calc(46 * 6.6px * 2.08 + 22px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
  }

  .screen :global(.poster) {
    position: absolute;
    inset: 10px 12px auto;
    display: none;
    cursor: pointer;
  }

  .demo[data-state='poster'] .screen :global(.poster-177) {
    display: block;
  }

  @media (min-width: 1281px) {
    .demo[data-state='poster'] .screen :global(.poster-177) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-190) {
      display: block;
    }
  }

  @media (min-width: 1367px) {
    .demo[data-state='poster'] .screen :global(.poster-190) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-202) {
      display: block;
    }
  }

  @media (min-width: 1446px) {
    .demo[data-state='poster'] .screen :global(.poster-202) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-220) {
      display: block;
    }
  }

  .demo[data-state='poster'] canvas {
    visibility: hidden;
  }

  .demo:not([data-state='poster']) .play,
  .demo[data-state='poster'] .strip {
    display: none;
  }

  canvas {
    display: block;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .keys {
    position: absolute;
    left: 12px;
    top: 10px;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    resize: none;
    font-size: 16px;
    caret-color: transparent;
    pointer-events: none;
  }

  .play {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    pointer-events: none;
  }

  .play-card {
    display: grid;
    justify-items: center;
    gap: 12px;
    max-width: min(420px, calc(100% - 32px));
    padding: 22px 24px 20px;
    border: 1px solid #2c2f40;
    background: #111219;
    pointer-events: auto;
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 22px;
    border: 0;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font);
    font-size: 15.5px;
    font-weight: 620;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .play-button:hover {
    background: var(--brand-hover);
  }

  .play-button:active {
    transform: translateY(1px);
  }

  .play-button svg {
    width: 14px;
    height: 14px;
  }

  .play-hint {
    max-width: 34ch;
    margin: 0;
    text-align: center;
    text-wrap: balance;
    font-size: 14.5px;
    line-height: 1.45;
    color: #c0c4d6;
  }

  .strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 14px;
    border-top: 1px solid var(--term-line);
    background: var(--term-bar);
  }

  .caption {
    margin: 0;
    min-width: 0;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
    color: #e4e7f2;
    text-wrap: pretty;
  }

  .caption::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 1em;
    margin-right: 10px;
    vertical-align: -0.14em;
    background: var(--brand);
  }

  .caption :global(code) {
    font-size: 0.85em;
  }

  .replay {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid #3a3e52;
    background: transparent;
    color: #e4e7f2;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .replay:hover {
    border-color: var(--brand);
    background: var(--brand);
  }

  .replay svg {
    width: 13px;
    height: 13px;
  }

  .spot {
    position: absolute;
    z-index: 2;
    outline: 2px solid #74a3ff;
    box-shadow: 0 0 0 200vmax rgb(10 11 16 / 0.62);
    pointer-events: none;
    transition:
      left 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      top 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      width 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
      height 0.45s cubic-bezier(0.3, 0.7, 0.2, 1);
    animation: spot-in 0.35s ease-out;
  }

  @keyframes spot-in {
    from {
      opacity: 0;
    }
  }

  .lapse {
    position: absolute;
    z-index: 4;
    right: 22px;
    top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border: 1px solid rgb(245 215 110 / 0.5);
    background: #111219;
    color: #f5d76e;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    animation: spot-in 0.3s ease-out;
  }

  .lapse svg {
    width: 14px;
    height: 14px;
    animation: lapse 0.7s linear infinite;
  }

  @keyframes lapse {
    50% {
      opacity: 0.35;
    }
  }

  .themes {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-right: 14px;
  }

  .swatch {
    width: 14px;
    height: 14px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: linear-gradient(135deg, var(--sw) 0 58%, var(--sw-2) 58% 100%);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .swatch:hover {
    transform: scale(1.18);
  }

  .swatch[aria-pressed='true'] {
    outline: 2px solid #74a3ff;
    outline-offset: 2px;
  }

  .live {
    color: var(--term-text-2);
  }

  .pointer {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 0;
    height: 0;
    pointer-events: none;
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.45));
  }

  .pointer svg {
    position: absolute;
    left: -3px;
    top: -2px;
  }

  .pointer::after {
    content: '';
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid #74a3ff;
    opacity: 0;
    transform: scale(0.3);
  }

  .pointer.right::after {
    border-color: #f5d76e;
  }

  .pointer.tap::after {
    animation: tap 0.5s ease-out;
  }

  @keyframes tap {
    0% {
      opacity: 0.9;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  @media (max-width: 899px) {
    .screen {
      min-height: calc(32 * 7.8px * 2.08 + 22px);
      padding: 8px;
    }

    .keys {
      left: 8px;
      top: 8px;
    }

    .screen :global(.poster) {
      inset: 8px 8px auto;
    }

    .demo[data-state='poster'] .screen :global(.poster-177) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-102) {
      display: block;
    }

    .lapse {
      right: 14px;
      top: 12px;
      font-size: 12.5px;
    }

    .frame::before,
    .frame::after {
      display: none;
    }
  }

  @media (max-width: 559px) {
    .screen {
      min-height: calc(34 * 7.4px * 2.08 + 16px);
    }

    .demo[data-state='poster'] .screen :global(.poster-wide) {
      display: none;
    }

    .demo[data-state='poster'] .screen :global(.poster-compact) {
      display: block;
    }

    .play-card {
      max-width: calc(100% - 24px);
      padding: 18px 14px 16px;
    }

    .play-button {
      height: auto;
      min-height: 46px;
      padding: 10px 14px;
      gap: 8px;
      font-size: 14.5px;
      text-align: center;
    }

    .play-hint {
      padding: 0 10px;
      text-align: center;
    }

    .strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .themes {
      display: none;
    }
  }
</style>
