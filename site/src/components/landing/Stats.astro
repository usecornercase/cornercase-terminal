---
import type { Measure, Weight } from '../../lib/speed';
import Race from './Race.astro';
import Weigh from './Weigh.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const times: Measure[] = [
  {
    title: 'Opening the app',
    what: 'From launching it until the workspace is usable.',
    values: [[0.034, '34 ms'], [0.45, '450 ms'], [3.2, '3.2 s'], [8.5, '8.5 s']],
  },
  {
    title: 'First look at the changes',
    what: 'From the click until the changes are on screen: 20 files, +794 −76.',
    values: [[0.002, '2 ms'], [0.41, '410 ms'], [1.1, '1.1 s'], [0.43, '430 ms']],
  },
  {
    title: 'Every look after that',
    what: 'The same changes, shown again.',
    values: [[0.002, '2 ms'], [0.09, '90 ms'], [0.33, '330 ms'], [0.14, '140 ms']],
  },
  {
    title: 'Opening a file',
    what: 'From the click until a file of 3,472 lines is on screen, coloured.',
    values: [[0.14, '140 ms'], [0.65, '650 ms'], [1.33, '1.3 s'], [0.47, '470 ms']],
  },
  {
    title: 'Finding a file by name',
    what: 'From the query until the file shows up, among 32,255 files.',
    values: [[0.019, '19 ms'], [0.3, '300 ms'], [0.19, '190 ms'], [0, 'no quick open']],
  },
  {
    title: 'Searching the files',
    what: 'From the query until the matches show, across 32,255 files.',
    values: [[0.069, '69 ms'], [0.43, '430 ms'], [0.49, '490 ms'], [0.1, '100 ms']],
  },
];
const sizes: Weight[] = [
  {
    title: 'Memory',
    what: 'What each app’s own processes use, without the shells.',
    less: 'less memory',
    next: 'lightest',
    values: [[53, '53 MB'], [432, '432 MB'], [793, '793 MB'], [1900, '1.9 GB']],
  },
  {
    title: 'Download',
    what: 'What you download to install it.',
    less: 'smaller download',
    next: 'smallest',
    values: [[4.8, '4.8 MB'], [148, '148 MB'], [219, '219 MB'], [229, '229 MB']],
  },
  {
    title: 'On disk',
    what: 'The space it takes once installed.',
    less: 'less disk space',
    next: 'smallest',
    values: [[12, '12 MB'], [353, '353 MB'], [642, '642 MB'], [807, '807 MB']],
  },
];
---

<section class="section stats" id="speed" aria-labelledby="speed-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">Speed</p>
      <h2 class="h2 stretch" id="speed-title" aria-label="Faaast. Really faaast.">
        <span aria-hidden="true">
          <span class="word">F<span class="a">a</span><span class="x" style="--k: 1">a</span><span class="x" style="--k: 2">a</span><span class="tail">st.</span></span>{' '}
          <em><span class="word">Really</span>{' '}<span class="word">f<span class="a">a</span><span class="x" style="--k: 1">a</span><span class="x" style="--k: 2">a</span><span class="tail">st.</span></span></em>
        </span>
      </h2>
      <p class="lead">
        It opens before you can blink, and shows what your agents changed, opens a file or finds one before you can click
        again. The other apps we tried? Up to 8.5 seconds, and nearly 2 GB.
      </p>
    </div>
    <Race measures={times} />
    <Weigh measures={sizes} />
    <p class="note reveal">
      <a href={`${base}/docs/help/faq/#is-it-fast`}>How we measured →</a>
    </p>
  </div>
</section>

<script>
  for (const title of document.querySelectorAll<HTMLElement>('.stretch')) {
    const measure = () => {
      const a = title.querySelector<HTMLElement>('.x')?.offsetWidth ?? 0;
      title.style.setProperty('--a', `${a}px`);
      let line = Number.NaN;
      let carry = 0;
      for (const word of title.querySelectorAll<HTMLElement>('.word')) {
        if (word.offsetTop !== line) {
          line = word.offsetTop;
          carry = 0;
        }
        word.style.setProperty('--carry', String(carry));
        carry += word.querySelectorAll('.x').length;
      }
    };
    measure();
    document.fonts.ready.then(measure);
    window.addEventListener('resize', measure, { passive: true });
  }
</script>

<style>
  .section.stats {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .head {
    max-width: 860px;
  }

  .h2 {
    font-size: clamp(32px, 4.2vw, 56px);
  }

  .stretch .word,
  .stretch .x,
  .stretch .tail {
    display: inline-block;
  }

  :global(.js) .stretch .word {
    transform: translateX(calc(var(--carry, 0) * var(--a, 0.55em) * -1));
  }

  :global(.js) .stretch .x {
    transform: translateX(calc(var(--k) * var(--a, 0.55em) * -1));
    opacity: 0;
    filter: blur(6px);
  }

  :global(.js) .stretch .tail {
    transform: translateX(calc(var(--a, 0.55em) * -2));
  }

  :global(.js) .head.in .stretch .word,
  :global(.js) .head.in .stretch .x,
  :global(.js) .head.in .stretch .tail {
    transform: none;
    opacity: 1;
    filter: none;
    transition:
      transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.35s,
      opacity 0.4s ease 0.35s,
      filter 0.7s ease 0.35s;
    transition-timing-function:
      linear(
        0,
        0.06,
        0.202,
        0.38,
        0.561,
        0.723,
        0.856,
        0.955,
        1.023,
        1.062,
        1.081,
        1.083,
        1.075,
        1.062,
        1.047,
        1.032,
        1.019,
        1.009,
        1.002,
        0.997,
        0.994,
        0.993,
        0.993,
        0.994,
        0.995,
        0.996,
        0.998,
        0.999,
        0.999,
        1
      ),
      ease,
      ease;
  }

  :global(.js) .head.in .stretch em .x,
  :global(.js) .head.in .stretch em .tail {
    transition-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stretch .word,
    :global(.js) .stretch .x,
    :global(.js) .stretch .tail {
      transform: none;
      opacity: 1;
      filter: none;
      transition: none;
    }
  }

  .note {
    margin: 22px 0 0;
    color: var(--text-3);
    font-size: 14.5px;
  }

  .note a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .note a:hover {
    color: var(--purple-3);
  }
</style>
