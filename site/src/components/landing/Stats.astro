---
import { localeOf, words } from '../../i18n';
import type { Measure, Value, Weight } from '../../lib/speed';
import Race from './Race.astro';
import Weigh from './Weigh.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = words(Astro.url);
const timed: Value[][] = [
  [[0.034, '34 ms'], [0.45, '450 ms'], [3.2, '3.2 s'], [8.5, '8.5 s']],
  [[0.002, '2 ms'], [0.41, '410 ms'], [1.1, '1.1 s'], [0.43, '430 ms']],
  [[0.002, '2 ms'], [0.09, '90 ms'], [0.33, '330 ms'], [0.14, '140 ms']],
  [[0.14, '140 ms'], [0.65, '650 ms'], [1.33, '1.3 s'], [0.47, '470 ms']],
  [[0.019, '19 ms'], [0.3, '300 ms'], [0.19, '190 ms'], [0, t.stats.noQuickOpen]],
  [[0.069, '69 ms'], [0.43, '430 ms'], [0.49, '490 ms'], [0.1, '100 ms']],
];
const weighed: Value[][] = [
  [[53, '53 MB'], [432, '432 MB'], [793, '793 MB'], [1900, '1.9 GB']],
  [[4.8, '4.8 MB'], [148, '148 MB'], [219, '219 MB'], [229, '229 MB']],
  [[12, '12 MB'], [353, '353 MB'], [642, '642 MB'], [807, '807 MB']],
];
const times: Measure[] = t.stats.times.map((m, i) => ({ ...m, values: timed[i] }));
const sizes: Weight[] = t.stats.sizes.map((m, i) => ({ ...m, values: weighed[i] }));
---

<section class="section stats" id="speed" aria-labelledby="speed-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="h2 stretch" id="speed-title" aria-label={t.stats.label}>
        <span aria-hidden="true">
          {
            t.stats.title.map((line, i) => {
              const parts = line.map((w, j) => (
                <Fragment>
                  {j > 0 && ' '}
                  {typeof w === 'string' ? (
                    <span class="word">{w}</span>
                  ) : (
                    <span class="word">
                      {w.pre}
                      <span class="a">{w.a}</span>
                      <span class="x" style="--k: 1">{w.a}</span>
                      <span class="x" style="--k: 2">{w.a}</span>
                      <span class="tail">{w.tail}</span>
                    </span>
                  )}
                </Fragment>
              ));
              return i === 0 ? parts : <Fragment>{' '}<span class="second">{parts}</span></Fragment>;
            })
          }
        </span>
      </h2>
      <p class="lead">{t.stats.lead}</p>
    </div>
    <Race measures={times} />
    <Weigh measures={sizes} />
    <p class="note reveal">
      <a href={`${base}/docs/help/faq/#is-it-fast`} hreflang={localeOf(Astro.url) === 'en' ? undefined : 'en'}>{t.stats.how}</a>
    </p>
  </div>
</section>

<script>
  for (const title of document.querySelectorAll<HTMLElement>('.stretch')) {
    const measure = () => {
      const a = title.querySelector<HTMLElement>('.x')?.offsetWidth ?? 0;
      title.style.setProperty('--a', `${a}px`);
      let line = Number.NaN;
      let carry = 0;
      for (const word of title.querySelectorAll<HTMLElement>('.word')) {
        if (word.offsetTop !== line) {
          line = word.offsetTop;
          carry = 0;
        }
        word.style.setProperty('--carry', String(carry));
        carry += word.querySelectorAll('.x').length;
      }
    };
    measure();
    document.fonts.ready.then(measure);
    window.addEventListener('resize', measure, { passive: true });
  }
</script>

<style>
  .section.stats {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .head {
    max-width: 900px;
  }

  .h2 {
    font-size: clamp(34px, 4.6vw, 64px);
  }

  .stretch .word,
  .stretch .x,
  .stretch .tail {
    display: inline-block;
  }

  :global(.js) .stretch .word {
    transform: translateX(calc(var(--carry, 0) * var(--a, 0.55em) * -1));
  }

  :global(.js) .stretch .x {
    transform: translateX(calc(var(--k) * var(--a, 0.55em) * -1));
    opacity: 0;
  }

  :global(.js) .stretch .tail {
    transform: translateX(calc(var(--a, 0.55em) * -2));
  }

  :global(.js) .head.in .stretch .word,
  :global(.js) .head.in .stretch .x,
  :global(.js) .head.in .stretch .tail {
    transform: none;
    opacity: 1;
    transition:
      transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.35s,
      opacity 0.4s ease 0.35s;
    transition-timing-function:
      linear(
        0,
        0.06,
        0.202,
        0.38,
        0.561,
        0.723,
        0.856,
        0.955,
        1.023,
        1.062,
        1.081,
        1.083,
        1.075,
        1.062,
        1.047,
        1.032,
        1.019,
        1.009,
        1.002,
        0.997,
        0.994,
        0.993,
        0.993,
        0.994,
        0.995,
        0.996,
        0.998,
        0.999,
        0.999,
        1
      ),
      ease;
  }

  :global(.js) .head.in .stretch .second .x,
  :global(.js) .head.in .stretch .second .tail {
    transition-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stretch .word,
    :global(.js) .stretch .x,
    :global(.js) .stretch .tail {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

  .note {
    margin: 24px 0 0;
    font-size: 15.5px;
  }

  .note a {
    color: var(--brand-ink);
    font-weight: 620;
    text-decoration: none;
  }

  .note a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
