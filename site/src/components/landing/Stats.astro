---
import { localeOf, words } from '../../i18n';
import type { Measure, Value, Weight } from '../../lib/speed';
import Race from './Race.astro';
import Weigh from './Weigh.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = words(Astro.url);
const timed: Value[][] = [
  [[0.034, '34 ms'], [0.45, '450 ms'], [3.2, '3.2 s'], [8.5, '8.5 s']],
  [[0.002, '2 ms'], [0.41, '410 ms'], [1.1, '1.1 s'], [0.43, '430 ms']],
  [[0.002, '2 ms'], [0.09, '90 ms'], [0.33, '330 ms'], [0.14, '140 ms']],
  [[0.14, '140 ms'], [0.65, '650 ms'], [1.33, '1.3 s'], [0.47, '470 ms']],
  [[0.019, '19 ms'], [0.3, '300 ms'], [0.19, '190 ms'], [0, t.stats.noQuickOpen]],
  [[0.069, '69 ms'], [0.43, '430 ms'], [0.49, '490 ms'], [0.1, '100 ms']],
];
const weighed: Value[][] = [
  [[53, '53 MB'], [432, '432 MB'], [793, '793 MB'], [1900, '1.9 GB']],
  [[4.8, '4.8 MB'], [148, '148 MB'], [219, '219 MB'], [229, '229 MB']],
  [[12, '12 MB'], [353, '353 MB'], [642, '642 MB'], [807, '807 MB']],
];
const times: Measure[] = t.stats.times.map((m, i) => ({ ...m, values: timed[i] }));
const sizes: Weight[] = t.stats.sizes.map((m, i) => ({ ...m, values: weighed[i] }));
---

<section class="section stats" id="speed" aria-labelledby="speed-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="h2" id="speed-title">{t.stats.title}</h2>
      <p class="lead">{t.stats.lead}</p>
    </div>
    <Race measures={times} />
    <Weigh measures={sizes} />
    <p class="note reveal">
      <a href={`${base}/docs/help/faq/#is-it-fast`} hreflang={localeOf(Astro.url) === 'en' ? undefined : 'en'}>{t.stats.how}</a>
    </p>
  </div>
</section>

<style>
  .section.stats {
    padding-top: 0;
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .head {
    max-width: 900px;
  }

  .note {
    margin: 24px 0 0;
    font-size: 15.5px;
  }

  .note a {
    color: var(--brand-ink);
    font-weight: 620;
    text-decoration: none;
  }

  .note a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
