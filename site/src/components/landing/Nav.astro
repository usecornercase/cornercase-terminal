---
import { LOCALES, home, localeOf, locales, words } from '../../i18n';

interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const locale = localeOf(Astro.url);
const t = words(Astro.url);
const repo = 'https://github.com/usecornercase/cornercase-terminal';
const discord = 'https://discord.gg/aYqCa4xC4R';
const anchor = (id: string) => (standalone ? `${home(locale)}#${id}` : `#${id}`);
---

<header class="nav" data-standalone={standalone ? '' : undefined}>
  <div class="wrap inner">
    <a class="brand" href={home(locale)} aria-label={t.home}>
      <svg viewBox="0 0 4 4" aria-hidden="true" shape-rendering="crispEdges"><path d="M1 0h3v1H1zM0 1h1v3H0z"></path></svg>
      <span>cornercase</span>
    </a>
    <nav class="links" aria-label={t.nav.label}>
      <a href={anchor('demo')}>{t.nav.demo}</a>
      <a href={anchor('speed')}>{t.nav.speed}</a>
      <a href={anchor('why')}>{t.nav.why}</a>
      <a href={anchor('more')}>{t.nav.more}</a>
      <a href={`${base}/plugins/`} hreflang={locale === 'en' ? undefined : 'en'}>{t.nav.plugins}</a>
      <a href={`${base}/docs/`} hreflang={locale === 'en' ? undefined : 'en'}>{t.nav.docs}</a>
    </nav>
    <div class="actions">
      <nav class="langs" aria-label={t.nav.language}>
        {
          locales.map((l) => (
            <a
              href={home(l)}
              hreflang={LOCALES[l].lang}
              lang={LOCALES[l].lang}
              title={LOCALES[l].name}
              aria-label={LOCALES[l].name}
              aria-current={l === locale ? 'page' : undefined}>
              {LOCALES[l].short}
            </a>
          ))
        }
      </nav>
      <a class="discord" href={discord} aria-label={t.nav.discord} title="Discord">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path></svg>
      </a>
      <a class="gh" href={repo} aria-label={t.nav.github} data-label={t.nav.stars}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span class="stars" data-stars>GitHub</span>
      </a>
      <a class="btn btn-primary install" href={anchor('install')}>{t.nav.install}</a>
    </div>
  </div>
</header>

<script>
  const standalone = document.querySelector('.nav')?.hasAttribute('data-standalone');
  const el = document.querySelector<HTMLElement>('[data-stars]');
  const key = 'cornercase-stars';
  const show = (n: number) => {
    if (!el || !Number.isFinite(n) || n < 25) return;
    el.textContent = n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);
    const label = el.parentElement?.dataset.label;
    if (label) el.parentElement?.setAttribute('aria-label', label.replace('{n}', String(n)));
  };
  let cached: string | null = null;
  try {
    cached = sessionStorage.getItem(key);
  } catch {}
  if (cached) show(Number(cached));
  else if (!standalone) {
    fetch('https://api.github.com/repos/usecornercase/cornercase-terminal')
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { stargazers_count?: number } | null) => {
        if (typeof data?.stargazers_count !== 'number') return;
        show(data.stargazers_count);
        try {
          sessionStorage.setItem(key, String(data.stargazers_count));
        } catch {}
      })
      .catch(() => {});
  }
  const nav = document.querySelector('.nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .nav.scrolled {
    background: rgb(7 6 11 / 0.78);
    border-bottom-color: var(--line);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
  }

  .brand svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: var(--purple);
  }

  .links {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .links a {
    padding: 7px 12px;
    white-space: nowrap;
    border-radius: 8px;
    color: var(--text-2);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .links a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .langs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 9px;
    border: 1px solid var(--line-2);
  }

  .langs a {
    padding: 4px 7px;
    border-radius: 6px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .langs a:hover {
    color: var(--text);
  }

  .langs a[aria-current] {
    color: var(--text);
    background: rgb(255 255 255 / 0.08);
  }

  .gh,
  .discord {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-radius: 9px;
    border: 1px solid var(--line-2);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .gh:hover,
  .discord:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.3);
  }

  .gh svg {
    flex: none;
    width: 17px;
    height: 17px;
  }

  .discord {
    justify-content: center;
    width: 36px;
    padding: 0;
  }

  .discord svg {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .actions .install {
    --h: 36px;
    padding: 0 15px;
    font-size: 14px;
    border-radius: 9px;
  }

  @media (max-width: 1160px) {
    .links a:not(:last-child) {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .nav {
      background: rgb(7 6 11 / 0.82);
      border-bottom-color: var(--line);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
    }
  }

  @media (max-width: 600px) {
    .inner {
      gap: 12px;
    }

    .links {
      display: none;
    }

    .actions {
      margin-left: auto;
    }

    .langs a {
      padding: 4px 5px;
    }

    .actions .install {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .gh {
      justify-content: center;
      width: 36px;
      padding: 0;
    }

    .gh .stars {
      display: none;
    }
  }
</style>
