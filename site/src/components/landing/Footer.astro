---
import { home, localeOf, words } from '../../i18n';
import InstallBox from './InstallBox.astro';
import Mark from './Mark.astro';

interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/usecornercase/cornercase-terminal';
const discord = 'https://discord.gg/aYqCa4xC4R';
const locale = localeOf(Astro.url);
const t = words(Astro.url);
const docsLang = locale === 'en' ? undefined : 'en';
const anchor = (id: string) => (standalone ? `${home(locale)}#${id}` : `#${id}`);
const columns: [string, [string, string, string?][]][] = [
  [
    t.footer.product,
    [
      [t.nav.demo, anchor('demo')],
      [t.nav.speed, anchor('speed')],
      [t.nav.why, anchor('why')],
      [t.nav.flows, anchor('flows')],
      [t.nav.more, anchor('more')],
      [t.nav.install, anchor('install')],
    ],
  ],
  [
    t.footer.docs,
    [
      [t.footer.introduction, `${base}/docs/`, docsLang],
      [t.footer.first, `${base}/docs/first-steps/`, docsLang],
      [t.footer.configuration, `${base}/docs/reference/configuration/`, docsLang],
      [t.footer.troubleshooting, `${base}/docs/help/troubleshooting/`, docsLang],
    ],
  ],
  [
    t.footer.project,
    [
      ['GitHub', repo],
      ['Discord', discord],
      [t.footer.issues, `${repo}/issues`],
      [t.footer.contributing, `${repo}/blob/main/CONTRIBUTING.md`],
      [t.footer.security, `${repo}/security/advisories/new`],
    ],
  ],
];
---

<footer class:list={['footer', { standalone }]}>
  <div class="wrap">
    {
      !standalone && (
      <div class="cta">
        <div class="say reveal">
          <h2>{t.footer.cta[0]}<br />{t.footer.cta[1]}{t.footer.cta[2]}{t.footer.cta[3]}</h2>
          <div class="get">
            <InstallBox />
          </div>
          <div class="actions">
            <a class="btn btn-ghost" href={`${base}/docs/first-steps/`} hreflang={docsLang}>{t.footer.first}</a>
            <a class="btn btn-ghost" href={repo}>{t.footer.star}</a>
            <a class="btn btn-ghost" href={discord}>{t.footer.discord}</a>
          </div>
        </div>
        <div class="poster reveal" style="--i: 2" aria-hidden="true">
          <Mark size={480} />
        </div>
      </div>
      )
    }
    <div class="grid">
      <div class="brand">
        <a class="logo" href={home(locale)} aria-label={t.home}>
          <Mark size={24} />
          cornercase
        </a>
        <p>{t.footer.tagline}</p>
      </div>
      {
        columns.map(([title, links]) => (
          <nav aria-label={title}>
            <h3>{title}</h3>
            <ul>
              {links.map(([label, href, lang]) => (
                <li>
                  <a href={href} hreflang={lang}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="legal">
      <span>© 2026 {t.footer.authors} · <a href={`${repo}/blob/main/LICENSE-MIT`}>MIT</a> {t.footer.or} <a href={`${repo}/blob/main/LICENSE-APACHE`}>Apache-2.0</a></span>
      <span>{t.footer.built}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: clamp(80px, 10vw, 152px) 0 40px;
    background: var(--bg);
    overflow: hidden;
  }

  .footer.standalone {
    padding-top: 0;
  }

  .footer.standalone .grid {
    margin-top: 0;
  }

  .cta {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .cta h2 {
    margin: 0;
    font-stretch: var(--wide);
    font-weight: 780;
    font-size: clamp(38px, 5.2vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .get {
    margin-top: clamp(28px, 3vw, 40px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .poster {
    justify-self: end;
    width: min(100%, 340px);
    color: var(--text);
  }

  .poster :global(.mark) {
    width: 100%;
    height: auto;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: clamp(96px, 10vw, 152px);
    padding-top: 40px;
    border-top: 2px solid var(--text);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
    font-stretch: var(--wide);
    font-weight: 760;
    font-size: 19px;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand p {
    max-width: 320px;
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 15.5px;
  }

  h3 {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
  }

  ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a,
  .legal a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 15px;
  }

  ul a:hover,
  .legal a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--text-3);
  }

  .legal a {
    font-size: 13.5px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .cta {
      grid-template-columns: minmax(0, 1fr);
    }

    .poster {
      display: none;
    }

    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
