---
import { APPS, type Weight, lead, slowest, times } from '../../lib/speed';

interface Props {
  measures: Weight[];
}

const { measures } = Astro.props;
const side = (k: number, j: number) => Math.sqrt(measures[k].values[j][0] / slowest(measures[k].values));
const sides = (j: number) => measures.map((_, k) => `--s${k}: ${side(k, j).toFixed(4)}`).join('; ');
---

<div class="weigh reveal" data-weigh data-k="0">
  <div class="stage" aria-hidden="true">
    <div class="squares">
      {
        [3, 2, 1, 0].map((j) => (
          <div class:list={['sq', { us: j === 0 }]} data-app={j} style={sides(j)}>
            <span class="tag">
              <span class="app">{APPS[j]}</span>
              {measures.map(({ values }, k) => (
                <b class={`v v${k}`}>{values[j][1]}</b>
              ))}
            </span>
          </div>
        ))
      }
      <i class="halo" style={sides(0)}></i>
    </div>
    <span class="scale">areas to scale</span>
  </div>
  <div class="kinds" role="tablist" aria-label="What we weighed">
    {
      measures.map(({ title }, k) => (
        <button
          type="button"
          role="tab"
          id={`weigh-tab-${k}`}
          aria-controls={`weigh-${k}`}
          aria-selected={k === 0 ? 'true' : 'false'}
          tabindex={k === 0 ? '0' : '-1'}>
          {title}
        </button>
      ))
    }
  </div>
  {
    measures.map(({ title, what, less, next, values }, k) => {
      const { x, app } = lead(values);
      return (
        <div
          class="panel"
          role="tabpanel"
          id={`weigh-${k}`}
          aria-labelledby={`weigh-tab-${k}`}
          data-on={k === 0 ? '' : undefined}>
          <h3 class="title">{title}</h3>
          <p class="verdict">
            <b data-lead={x}>{times(x)}</b>{' '}
            <span>
              {less} than {app}, <br />
              the next {next}
            </span>
          </p>
          <ul class="sr-only">
            {values.map(([, label], j) => (
              <li>
                {APPS[j]}: {label}
              </li>
            ))}
          </ul>
          <p class="what">{what}</p>
        </div>
      );
    })
  }
</div>

<script>
  import { countUp } from '../../lib/speed';

  function weigh(root: HTMLElement): void {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const squares = [...root.querySelectorAll<HTMLElement>('.sq')];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let first = 0;

    const count = (k: number) => {
      const x = panels[k].querySelector<HTMLElement>('[data-lead]');
      if (x && !still) countUp(x, Number(x.dataset.lead), 900);
    };

    const select = (k: number) => {
      if (root.dataset.k === String(k)) return;
      clearTimeout(first);
      root.dataset.k = String(k);
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === k));
        tab.tabIndex = i === k ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== k;
        panel.toggleAttribute('data-on', i === k);
      });
      count(k);
    };

    tabs.forEach((tab, k) => tab.addEventListener('click', () => select(k)));
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const n = tabs.length;
      const to = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[key];
      if (i < 0 || to === undefined) return;
      event.preventDefault();
      tabs[to].focus();
      select(to);
    });

    for (const square of squares) {
      square.addEventListener('pointerenter', () => square.classList.add('hot'));
      square.addEventListener('pointerleave', () => square.classList.remove('hot'));
    }

    panels.forEach((panel, i) => (panel.hidden = i !== 0));
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        root.classList.add('grown', 'growing');
        window.setTimeout(() => root.classList.remove('growing'), 2400);
        first = window.setTimeout(() => count(Number(root.dataset.k)), 700);
      },
      { threshold: 0.45 },
    );
    seen.observe(root);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-weigh]')) weigh(root);
</script>

<style>
  .weigh {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas:
      'stage .'
      'stage kinds'
      'stage say'
      'stage .';
    gap: 0 clamp(28px, 5vw, 72px);
    margin-top: 16px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 20px;
    border: 1px solid var(--line);
    background:
      radial-gradient(70% 90% at 0% 0%, rgb(135 95 255 / 0.12), transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent 30%),
      var(--panel);
    overflow: hidden;
  }

  .stage {
    grid-area: stage;
    position: relative;
    padding: 0 0 46px;
  }

  .squares {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
  }

  .sq {
    --s: var(--s0);
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--s) * 100%);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 3px;
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.085) 1px, transparent 1.5px) 0 0 / 12px 12px,
      rgb(255 255 255 / 0.02);
    transition:
      width 1.1s cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 0.3s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
    transition-timing-function: linear(
        0,
        0.06,
        0.202,
        0.38,
        0.561,
        0.723,
        0.856,
        0.955,
        1.023,
        1.062,
        1.081,
        1.083,
        1.075,
        1.062,
        1.047,
        1.032,
        1.019,
        1.009,
        1.002,
        0.997,
        0.994,
        0.993,
        0.993,
        0.994,
        0.995,
        0.996,
        0.998,
        0.999,
        0.999,
        1
      ),
      ease, ease, ease;
  }

  .weigh[data-k='1'] :is(.sq, .halo) {
    --s: var(--s1);
  }

  .weigh[data-k='2'] :is(.sq, .halo) {
    --s: var(--s2);
  }

  :global(.js) .weigh:not(.grown) :is(.sq, .halo) {
    width: 0;
    opacity: 0;
  }

  .weigh.growing .sq[data-app='2'] {
    transition-delay: 0.12s;
  }

  .weigh.growing .sq[data-app='1'] {
    transition-delay: 0.24s;
  }

  .weigh.growing :is(.sq[data-app='0'], .halo) {
    transition-delay: 0.75s;
  }

  .sq.hot {
    border-color: rgb(255 255 255 / 0.4);
    background-color: rgb(255 255 255 / 0.05);
  }

  .sq.hot .v {
    color: var(--text);
  }

  .sq.us {
    z-index: 1;
    border: 0;
    border-radius: 2px;
    background: linear-gradient(135deg, #b9a4ff, #7552f2 70%);
    box-shadow:
      0 0 0 1px rgb(201 184 255 / 0.6),
      0 0 24px rgb(135 95 255 / 0.75);
  }

  .halo {
    --s: var(--s0);
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--s) * 100%);
    aspect-ratio: 1;
    pointer-events: none;
    transition:
      width 1.1s cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 0.6s ease;
  }

  .halo::before {
    content: '';
    position: absolute;
    inset: -110%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(135 95 255 / 0.5), rgb(135 95 255 / 0.16) 50%, transparent);
    animation: breathe 3.4s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      opacity: 0.45;
      transform: scale(0.82);
    }
  }

  .tag {
    position: absolute;
    right: 12px;
    bottom: 10px;
    display: grid;
    justify-items: end;
    gap: 2px;
    font-family: var(--font-mono);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  :global(.js) .weigh:not(.grown) .tag {
    opacity: 0;
  }

  .weigh.growing .tag {
    transition-delay: 0.5s;
  }

  .weigh.growing .sq.us .tag {
    transition-delay: 1.25s;
  }

  .app {
    font-size: 12px;
    color: var(--text-3);
  }

  .v {
    display: none;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-2);
  }

  .weigh[data-k='0'] .v0,
  .weigh[data-k='1'] .v1,
  .weigh[data-k='2'] .v2 {
    display: block;
    animation: swap 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .sq[data-app='3'] .tag {
    top: calc(100% + 12px);
    right: 0;
    bottom: auto;
  }

  .sq.us .tag {
    top: 50%;
    translate: 0 -50%;
    left: calc(100% + 14px);
    right: auto;
    bottom: auto;
    justify-items: start;
  }

  .sq.us .app {
    color: var(--text);
    font-weight: 700;
  }

  .sq.us .v {
    color: var(--purple-3);
    font-size: 17px;
  }

  .scale {
    position: absolute;
    left: 0;
    bottom: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .kinds {
    grid-area: kinds;
    justify-self: start;
    align-self: start;
    margin-bottom: 40px;
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.02);
  }

  :global(html:not(.js)) .kinds {
    display: none;
  }

  .kinds button {
    padding: 8px 14px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-3);
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .kinds button:hover {
    color: var(--text);
  }

  .kinds [aria-selected='true'] {
    background: rgb(255 255 255 / 0.08);
    color: var(--text);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .panel {
    grid-area: say;
  }

  :global(.js) .panel:not([data-on]) {
    display: none;
  }

  :global(html:not(.js)) .panel {
    grid-area: auto;
    grid-column: 2;
  }

  .panel .title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }

  :global(.js) .panel .title {
    display: none;
  }

  .verdict {
    margin: 0;
  }

  .verdict b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(72px, 9vw, 128px);
    font-weight: 780;
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
    color: transparent;
    background: linear-gradient(100deg, var(--purple-2) 10%, #d8cbff 55%, var(--cyan) 110%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .verdict span {
    display: block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .what {
    margin: 18px 0 0;
    max-width: 420px;
    color: var(--text-3);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .sq,
    .halo,
    .tag {
      transition: none;
    }
  }

  @media (max-width: 700px) {
    .weigh {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'kinds'
        'stage'
        'say';
      gap: 22px;
    }

    .kinds {
      margin-bottom: 0;
    }

    .squares {
      width: min(100%, 420px);
    }
  }

  @media (max-width: 520px) {
    .kinds {
      justify-self: stretch;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .kinds button {
      padding: 8px 6px;
      font-size: 13.5px;
    }

    .app {
      font-size: 11px;
    }

    .v {
      font-size: 13.5px;
    }

    .sq.us .v {
      font-size: 15px;
    }

    .tag {
      right: 8px;
      bottom: 6px;
    }
  }
</style>
