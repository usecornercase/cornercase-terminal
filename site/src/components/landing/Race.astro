---
import { words } from '../../i18n';
import { APPS, type Measure, clock, lead, slowest, ticks, times } from '../../lib/speed';

interface Props {
  measures: Measure[];
}

const { measures } = Astro.props;
const t = words(Astro.url);
---

<div class="race reveal" data-race data-and={t.race.and}>
  <div class="tasks" role="tablist" aria-label={t.race.label}>
    {
      measures.map(({ title, values }, i) => (
        <button
          type="button"
          role="tab"
          class="task"
          id={`race-tab-${i}`}
          aria-controls={`race-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}>
          <span class="title">{title}</span>
          <span class="us">{values[0][1]}</span>
          <i class="p" aria-hidden="true" />
        </button>
      ))
    }
  </div>
  {
    measures.map(({ title, what, values }, i) => {
      const max = slowest(values);
      const { x, app } = lead(values);
      const [faster, next] = t.race.verdict(app);
      return (
        <div
          class="panel"
          role="tabpanel"
          id={`race-${i}`}
          aria-labelledby={`race-tab-${i}`}
          data-on={i === 0 ? '' : undefined}
          data-max={max}
          style={`--max: ${max}`}>
          <div class="top">
            <div class="say">
              <h3 class="title">{title}</h3>
              <p class="what">{what}</p>
              <div class="slot">
                <p class="verdict">
                  <b data-lead={x}>{times(x)}</b>{' '}
                  <span>
                    {faster} <br />
                    {next}
                  </span>
                </p>
                <p class="wait" aria-hidden="true">
                  <i class="spin" />
                  <span>
                    {t.race.waiting} <b data-wait /><span class="ellipsis"><i>.</i><i>.</i><i>.</i></span>
                  </span>
                </p>
              </div>
            </div>
            <div class="clock">
              <div class="row">
                <span class="live" aria-hidden="true">
                  <i />
                  {t.race.live}
                </span>
                <button type="button" class="again" data-again>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3M3.5 2.5v3h3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {t.race.again}
                </button>
              </div>
              <span class="digits" aria-hidden="true">
                <span data-clock>{clock(max)}</span>
                <small>s</small>
              </span>
            </div>
          </div>
          <div class="plot">
            <div class="grid" aria-hidden="true">
              {ticks(max).map(([at, label]) => (
                <span class="tick" style={`--at: ${at / max}`}>
                  <em>{label}</em>
                </span>
              ))}
              <span class="sweep">
                <span class="head">
                  <i />
                </span>
              </span>
            </div>
            <ol class="lanes">
              {values.map(([t, label], j) => (
                <li
                  class:list={['lane', { us: j === 0, none: t === 0 }]}
                  data-t={t}
                  data-app={APPS[j]}
                  style={`--t: ${t}`}>
                  <span class="name">
                    <i class="state" aria-hidden="true" />
                    {APPS[j]}
                  </span>
                  <span class="track">
                    <span class="bar" />
                    <span class="time">{label}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  import { clock, countUp } from '../../lib/speed';

  const HOLD = 3500;

  function race(root: HTMLElement): void {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const lanes = panels.map((panel) => [...panel.querySelectorAll<HTMLElement>('.lane')]);
    const digits = panels.map((panel) => panel.querySelector<HTMLElement>('[data-clock]'));
    const waits = panels.map((panel) => panel.querySelector<HTMLElement>('[data-wait]'));
    const list = (names: string[]) =>
      names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} ${root.dataset.and} ${names[names.length - 1]}`;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let start = 0;
    let frame = 0;
    let wait = 0;
    let started = false;
    let touring = !still;
    let visible = false;
    let due = false;

    const select = (i: number) => {
      current = i;
      tabs.forEach((tab, j) => {
        tab.setAttribute('aria-selected', String(j === i));
        tab.tabIndex = j === i ? 0 : -1;
        tab.style.setProperty('--p', '0');
      });
      panels.forEach((panel, j) => {
        panel.hidden = j !== i;
        panel.toggleAttribute('data-on', j === i);
      });
    };

    const show = (i: number, t: number) => {
      const max = Number(panels[i].dataset.max);
      panels[i].style.setProperty('--now', String(t));
      tabs[i].style.setProperty('--p', String(t / max));
      const shown = digits[i];
      if (shown) shown.textContent = clock(t);
      for (const lane of lanes[i]) lane.classList.toggle('done', t >= Number(lane.dataset.t));
      const left = lanes[i].filter((lane) => !lane.classList.contains('done')).map((lane) => lane.dataset.app ?? '');
      panels[i].classList.toggle('waiting', left.length > 0 && lanes[i][0].classList.contains('done'));
      const names = waits[i];
      const text = list(left);
      if (names && left.length && names.textContent !== text) names.textContent = text;
    };

    const finish = (i: number) => {
      const panel = panels[i];
      panel.classList.remove('running', 'waiting');
      panel.classList.add('over');
      const x = panel.querySelector<HTMLElement>('[data-lead]');
      if (x && !still) countUp(x, Number(x.dataset.lead), 1100);
      if (touring && i < panels.length - 1) wait = window.setTimeout(next, HOLD);
      else touring = false;
    };

    const step = (now: number) => {
      const max = Number(panels[current].dataset.max);
      const t = Math.min(Math.max(0, (now - start) / 1000), max);
      show(current, t);
      if (t < max) frame = requestAnimationFrame(step);
      else finish(current);
    };

    const play = (i: number) => {
      started = true;
      due = false;
      cancelAnimationFrame(frame);
      clearTimeout(wait);
      select(i);
      const panel = panels[i];
      panel.classList.remove('over', 'running', 'waiting');
      if (still) {
        show(i, Number(panel.dataset.max));
        finish(i);
        return;
      }
      show(i, 0);
      panel.classList.add('running');
      start = performance.now();
      frame = requestAnimationFrame(step);
    };

    const next = () => {
      if (!touring) return;
      if (!visible) {
        due = true;
        return;
      }
      play(current + 1);
    };

    const take = (i: number) => {
      touring = false;
      play(i);
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => take(i)));
    root.querySelectorAll('[data-again]').forEach((button) => button.addEventListener('click', () => take(current)));
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const n = tabs.length;
      const to = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[key];
      if (i < 0 || to === undefined) return;
      event.preventDefault();
      tabs[to].focus();
      take(to);
    });

    select(0);
    if (still) play(0);
    else show(0, 0);

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return;
        if (!started) {
          clearTimeout(wait);
          wait = window.setTimeout(() => play(current), 250);
        } else if (due) {
          due = false;
          wait = window.setTimeout(next, 900);
        }
      },
      { threshold: 0.5 },
    ).observe(root);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-race]')) race(root);
</script>

<style>
  .race {
    --name: 128px;
    --gap: 18px;
    --gutter: 84px;
    position: relative;
    --bar: #a3a9b1;
    --bar-wait: #c3c8ce;
    margin-top: clamp(32px, 4vw, 48px);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .race {
      --bar: #50555e;
      --bar-wait: #3a3e45;
    }
  }

  .tasks {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--line);
    background: var(--line);
  }

  :global(html:not(.js)) .tasks {
    display: none;
  }

  .task {
    position: relative;
    display: grid;
    align-content: start;
    gap: 3px;
    min-width: 0;
    padding: 14px 16px 15px;
    border: 0;
    background: var(--bg-2);
    color: var(--text-3);
    font-family: var(--font);
    text-align: left;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .task:hover {
    color: var(--text-2);
  }

  .task[aria-selected='true'] {
    color: var(--text);
    background: var(--surface);
  }

  .task:focus-visible {
    outline-offset: -3px;
  }

  .task .title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .task .us {
    font-size: 14px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--brand-ink);
    opacity: 0.8;
  }

  .task[aria-selected='true'] .us {
    opacity: 1;
  }

  .task .p {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 3px;
    background: var(--brand);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .task[aria-selected='false'] .p {
    display: none;
  }

  .panel {
    --now: 1000;
    padding: 30px 34px 34px;
  }

  :global(.js) .panel {
    --now: 0;
  }

  :global(.js) .panel:not([data-on]) {
    display: none;
  }

  :global(.js) .panel[data-on] {
    animation: enter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  :global(html:not(.js)) .panel + .panel {
    border-top: 1px solid var(--line);
  }

  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 26px;
  }

  .say {
    min-width: 0;
  }

  .say .title {
    margin: 0 0 6px;
    font-stretch: var(--wide);
    font-size: 22px;
    font-weight: 720;
    letter-spacing: -0.02em;
  }

  :global(.js) .say .title {
    display: none;
  }

  .what {
    margin: 0;
    max-width: 520px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.5;
  }

  .slot {
    display: grid;
    margin-top: 18px;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .wait {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: 10px;
    margin: 0;
    color: var(--text-2);
    font-size: 15px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .wait b {
    color: var(--text);
    font-weight: 600;
  }

  .ellipsis i {
    font-style: normal;
    animation: dot 1.2s ease-in-out infinite;
  }

  .ellipsis i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .ellipsis i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot {
    0%,
    60%,
    100% {
      opacity: 0.2;
    }
    30% {
      opacity: 1;
    }
  }

  .waiting .wait {
    opacity: 1;
    transform: none;
  }

  .spin {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--yellow);
    background: linear-gradient(90deg, var(--yellow) 50%, transparent 0);
    animation: spin 0.9s linear infinite;
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    transition:
      opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .verdict b {
    font-stretch: var(--wide);
    font-size: clamp(46px, 5vw, 70px);
    font-weight: 780;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--brand-ink);
  }

  .verdict span {
    color: var(--text);
    font-size: 18px;
    font-weight: 620;
    line-height: 1.25;
  }

  :global(.js) .panel:not(.over) .verdict {
    opacity: 0;
    transform: translateY(12px);
  }

  .clock {
    display: grid;
    justify-items: end;
    gap: 8px;
    flex: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
    transition: color 0.3s ease;
  }

  .live i {
    display: none;
  }

  .running .live {
    color: var(--brand-ink);
  }

  .again {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--text-2);
    font-family: var(--font);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .again:hover {
    color: var(--on-brand);
    border-color: var(--brand);
    background: var(--brand);
  }

  .again svg {
    width: 12px;
    height: 12px;
  }

  :global(html:not(.js)) .clock {
    display: none;
  }

  .digits {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: clamp(46px, 5.6vw, 78px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    transition: color 0.4s ease;
  }

  .running .digits {
    color: var(--text);
  }

  .over .digits {
    animation: stop 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  @keyframes stop {
    from {
      transform: scale(1.06);
    }
  }

  .digits small {
    margin-left: 0.18em;
    font-size: 0.36em;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-3);
  }

  .plot {
    position: relative;
    padding-bottom: 30px;
  }

  .grid {
    position: absolute;
    top: -10px;
    bottom: 30px;
    left: calc(var(--name) + var(--gap));
    right: var(--gutter);
    pointer-events: none;
  }

  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--at) * 100%);
    width: 1px;
    background: var(--line);
  }

  .tick em {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    translate: -50% 0;
    font-size: 13px;
    font-style: normal;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    white-space: nowrap;
  }

  .tick:first-child em {
    translate: 0 0;
  }

  .sweep {
    position: absolute;
    inset: 0;
    clip-path: inset(-40px -40px -40px -4px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .running .sweep {
    opacity: 1;
  }

  .head {
    position: absolute;
    inset: -6px 0;
    transform: translateX(calc(min(var(--now), var(--max)) / var(--max) * 100%));
  }

  .head::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    background: var(--brand);
  }

  .head i {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 8px;
    height: 8px;
    background: var(--brand);
  }

  .lanes {
    position: relative;
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lane {
    position: relative;
    display: grid;
    grid-template-columns: var(--name) minmax(0, 1fr);
    align-items: center;
    gap: var(--gap);
    height: 44px;
  }



  .name {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .state {
    display: grid;
    place-items: center;
    flex: none;
    width: 12px;
    height: 12px;
    font-style: normal;
  }

  .state::before {
    content: '✓';
    color: var(--green);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }

  :global(.js) .panel:not(.over) .lane:not(.done) .name {
    color: var(--text-3);
  }

  :global(.js) .panel:not(.over) .lane:not(.done) .state::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  :global(.js) .panel.running .lane:not(.done) .state::before {
    color: var(--yellow);
    background: linear-gradient(90deg, currentColor 50%, transparent 0);
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  :global(.js) .lane.done .state::before {
    animation: tick 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @keyframes tick {
    from {
      transform: scale(0.2);
      opacity: 0;
    }
  }

  .none .state::before {
    content: '-';
    color: var(--text-3);
  }

  .us .name {
    color: var(--text);
    font-weight: 720;
  }

  .track {
    --w: max(4px, (100% - var(--gutter)) * min(var(--now), var(--t)) / var(--max));
    position: relative;
    height: 100%;
  }

  :global(.js) .panel:not(.over) .lane:not(.done) .track {
    --w: calc((100% - var(--gutter)) * min(var(--now), var(--t)) / var(--max));
  }

  .bar {
    position: absolute;
    left: 0;
    top: 50%;
    width: var(--w);
    height: 22px;
    margin-top: -11px;
    background: var(--bar);
  }

  .lane:not(.us) .bar {
    overflow: hidden;
  }

  .lane:not(.us) .bar::before {
    content: '';
    position: absolute;
    inset: 0 0 0 -16px;
    background: linear-gradient(
        -45deg,
        rgb(128 128 128 / 0.22) 25%,
        transparent 25% 50%,
        rgb(128 128 128 / 0.22) 50% 75%,
        transparent 75%
      )
      0 0 / 16px 16px;
    opacity: 0;
  }

  :global(.js) .panel:not(.over) .lane:not(.done) .bar {
    background: var(--bar-wait);
  }

  :global(.js) .panel.running .lane:not(.done) .bar::before {
    opacity: 1;
    animation: stripes 0.45s linear infinite;
  }

  @keyframes stripes {
    to {
      transform: translateX(16px);
    }
  }

  :global(.js) .lane.done:not(.us) .bar {
    animation: settle 0.6s ease-out;
  }

  @keyframes settle {
    from {
      background-color: var(--text);
    }
  }

  .us .bar {
    background: var(--brand);
  }

  .us .track::after {
    content: '';
    position: absolute;
    top: 50%;
    left: var(--w);
    width: 220px;
    height: 2px;
    margin-top: -1px;
    background: var(--brand);
    opacity: 0;
    transform-origin: left;
    pointer-events: none;
  }

  :global(.js) .us.done .track::after {
    animation: whoosh 0.75s cubic-bezier(0.15, 0.6, 0.3, 1);
  }

  @keyframes whoosh {
    0% {
      opacity: 0;
      transform: translateX(-60px) scaleX(0.3);
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(min(60vw, 640px)) scaleX(1);
    }
  }

  .time {
    position: absolute;
    top: 50%;
    left: calc(var(--w) + 12px);
    translate: 0 -50%;
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
    white-space: nowrap;
    transition:
      opacity 0.35s ease,
      translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.js) .panel:not(.over) .lane:not(.done) .time {
    opacity: 0;
    translate: -8px -50%;
  }

  .us .time {
    color: var(--brand-ink);
    font-size: 16px;
    font-weight: 720;
  }

  :global(.js) .us.done .time {
    animation: pop 0.55s cubic-bezier(0.3, 1.7, 0.5, 1);
  }

  @keyframes pop {
    from {
      transform: scale(0.5);
    }
  }

  .none .bar {
    display: none;
  }

  .none .track::before {
    content: '';
    position: absolute;
    left: 0;
    right: var(--gutter);
    top: 50%;
    border-top: 1px dashed var(--line-2);
  }

