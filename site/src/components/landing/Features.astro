---
import { localeOf, words } from '../../i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).features;
const links = [
  'guides/projects-workspaces-tabs/',
  'reference/agents/',
  'guides/issues-and-agents/',
  'guides/changes/',
  'guides/files/',
  'guides/flows/',
  'guides/sessions/',
  'guides/phone/',
  'guides/scripts-and-agents/',
];
const items = t.items.map(([title, text], i) => ({ title, text, path: links[i] }));
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 class="h2" id="features-title"><span class="line">{t.title[0]}</span>{' '}<span class="line">{t.title[1]}</span></h2>
      <p class="lead">{t.lead}</p>
    </div>
    <ul class="tiles">
      {
        items.map(({ title, text, path }, i) => (
          <li class="reveal" style={`--i: ${i % 3}`}>
            <a href={docs(path)} hreflang={docsLang}>
              <b>{title}</b>
              <span>{text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section.features {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: 0;
  }

  .head {
    max-width: 880px;
  }

  .line {
    display: block;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(24px, 3vw, 44px);
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    padding: 22px 0 30px;
    border-top: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  b {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  a:hover b {
    text-decoration-color: var(--brand);
  }

  a span {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
