---
import { localeOf, words } from '../../i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const docsLang = localeOf(Astro.url) === 'en' ? undefined : 'en';
const t = words(Astro.url).features;
const links = [
  'guides/projects-workspaces-tabs/',
  'reference/agents/',
  'guides/issues-and-agents/',
  'guides/changes/',
  'guides/files/',
  'guides/flows/',
  'guides/sessions/',
  'guides/phone/',
  'guides/scripts-and-agents/',
];
const items = t.items.map(([title, text], i) => ({ title, text, path: links[i] }));
---

<section class="section features" id="features" data-section="features" data-chapter data-side="left" aria-labelledby="features-title">
  <div class="pin">
    <div class="cap" data-cap>
      <div class="head">
        <h2 class="h2" id="features-title" data-title><span class="line">{t.title[0]}</span>{' '}<span class="line">{t.title[1]}</span></h2>
        <p class="lead">{t.lead}</p>
      </div>
      <ul class="tiles">
        {
          items.map(({ title, text, path }) => (
            <li data-feature>
              <a href={docs(path)} hreflang={docsLang}>
                <b>{title}</b>
                <span>{text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .section.features {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: 0;
  }

  .cap {
    width: 100%;
    max-width: calc(var(--wrap) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .head {
    max-width: 880px;
  }

  .line {
    display: block;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(24px, 3vw, 44px);
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    padding: 22px 0 30px;
    border-top: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  b {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  a:hover b {
    text-decoration-color: var(--brand);
  }

  a span {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.55;
  }

  :global(.motion) .section.features {
    height: 620lvh;
    padding: 0;
    scroll-margin-top: -76lvh;
  }

  :global(.motion) .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.motion) .pin::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: calc(var(--cap) + 56px);
    background: linear-gradient(90deg, rgb(9 10 13 / 0.97) 78%, rgb(9 10 13 / 0.7) 90%, transparent);
    opacity: var(--scrim, 0);
    pointer-events: none;
  }

  :global(.motion) .cap {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    width: clamp(330px, 31vw, calc(540px * var(--big)));
    max-width: none;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: auto;
  }

  :global(.motion) .h2 {
    font-size: clamp(32px, 3.5vw, calc(62px * var(--big)));
    line-height: 1;
  }

  :global(.motion) .lead {
    margin-top: clamp(12px, 1.8vh, 18px);
    font-size: clamp(15px, 1.15vw, calc(17.5px * var(--big)));
    line-height: 1.45;
  }

  :global(.motion) .tiles {
    display: block;
    margin-top: clamp(14px, 2.4vh, 26px);
    border-bottom: 1px solid var(--line);
  }

  :global(.motion) a {
    grid-template-rows: auto 0fr;
    gap: 0;
    height: auto;
    padding: clamp(5px, 0.9vh, 9px) 0;
    border-top-color: var(--line);
    transition: grid-template-rows 0.4s var(--expo);
  }

  :global(.motion) b {
    color: var(--text-3);
    font-stretch: var(--wide);
    font-size: clamp(15px, 1.25vw, calc(19px * var(--big)));
    transition:
      color 0.25s,
      transform 0.4s var(--expo);
  }

  :global(.motion) a span {
    min-height: 0;
    overflow: hidden;
    font-size: clamp(14px, 1.05vw, calc(16px * var(--big)));
    line-height: 1.45;
    opacity: 0;
    transition: opacity 0.3s;
  }

  :global(.motion) li:global(.is-on) a {
    grid-template-rows: auto 1fr;
  }

  :global(.motion) li:global(.is-on) b {
    color: var(--brand-ink);
    transform: translateX(8px);
  }

  :global(.motion) li:global(.is-on) a span {
    padding: 4px 0 6px 8px;
    opacity: 1;
  }

  :global(.motion) li:global(.was-on) b {
    color: var(--text);
  }

  @media (max-width: 979px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(.motion) .pin::before {
      display: none;
    }

    :global(.motion) .cap {
      left: 10px;
      right: 10px;
      top: auto;
      bottom: 10px;
      width: auto;
      padding: 16px 16px 12px;
      border: 1px solid var(--line-2);
      background: rgb(12 14 19 / 0.94);
    }

    :global(.motion) .h2 {
      font-size: clamp(22px, 5.6vw, 34px);
    }

    :global(.motion) .lead {
      display: none;
    }

    :global(.motion) .tiles {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      min-height: 7.6em;
      margin-top: 10px;
      border-bottom: 0;
    }

    :global(.motion) li {
      grid-area: 1 / 1;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }

    :global(.motion) li:global(.is-on) {
      opacity: 1;
      pointer-events: auto;
    }

    :global(.motion) a {
      border-top: 0;
      padding: 0;
    }

    :global(.motion) li:global(.is-on) b {
      transform: none;
    }

    :global(.motion) li:global(.is-on) a span {
      padding: 4px 0 0;
    }
  }

  @media (max-width: 600px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 980px) and (max-height: 780px) {
    :global(.motion) .lead {
      display: none;
    }
  }
</style>
