---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/symbols.css';
import '../styles/landing.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import jetbrains from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { LOCALES, home, localeOf, locales, words } from '../i18n';

const locale = localeOf(Astro.url);
const t = words(Astro.url);
const { title, description } = t;
const url = (l: typeof locale) => new URL(home(l), Astro.site).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={LOCALES[locale].lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={LOCALES[l].lang} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={archivo} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={jetbrains} />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALES[locale].og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALES[l].og} />)}
    <meta property="og:image" content={`${site}${base}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${base}/og.png`} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still || !window.WebGL2RenderingContext || window.innerHeight < 420) return;
        root.classList.add('motion', 'intro');
        setTimeout(function () {
          if (window.cornercaseShow) return;
          root.classList.remove('motion', 'intro');
          window.dispatchEvent(new Event('cornercase:plain'));
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <canvas class="field" data-field aria-hidden="true"></canvas>
    <slot />
    <script>
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            seen.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));
    </script>
  </body>
</html>
