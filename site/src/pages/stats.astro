---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import InstallBox from '../components/landing/InstallBox.astro';
import { policy } from '../lib/csp';
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL('https://usecornercase.dev');
const image = new URL(`${base}stats-og.png`, origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Security-Policy" content={policy("'self' blob: data:", import.meta.env.DEV)} />
    <meta name="description" content="Your agents' work in parallel, on a card you can share. Made privately in your browser." />
    <meta property="og:title" content="cornercase stats" />
    <meta property="og:description" content="See how much work your agents do in parallel. Make a card and share it." />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(`${base}stats/`, origin)} />
    <title>cornercase stats</title>
  </head>
  <body>
    <main>
      <a class="home" href={base}>cornercase</a>
      <h1>Your agents, in parallel.</h1>
      <p>Make a card of the work your agents did in cornercase.</p>
      <p data-error role="alert" hidden></p>
      <section data-stats>
        <div role="tablist" aria-label="Stats window">
          <button role="tab" data-window="24h" aria-selected="false">24 h</button>
          <button role="tab" data-window="7d" aria-selected="true">7 days</button>
          <button role="tab" data-window="all" aria-selected="false">total</button>
        </div>
        <p data-example>This is an example. Copy your own link with <code>cornercase stats --share</code> or <strong>share</strong> in Usage → Stats.</p>
        <div class="stage" data-stage role="img" aria-label="cornercase stats ticket">
          <canvas class="backdrop" data-backdrop aria-hidden="true"></canvas>
          <div class="space" data-space aria-hidden="true">
            <canvas class="blur" data-halo></canvas>
            <canvas class="blur" data-shadow></canvas>
            <div class="ticket" data-ticket>
              <canvas data-face></canvas>
              <div class="foil" data-foil="iris"><i></i></div>
              <div class="foil" data-foil="edge"><i></i></div>
              <div class="glare" data-glare><i></i></div>
            </div>
          </div>
        </div>
        <div class="buttons">
          <button data-download>download PNG</button>
          <button data-copy-image hidden>copy image</button>
          <button data-share-image hidden>share</button>
          <a data-x target="_blank" rel="noopener noreferrer">post on X</a>
          <a data-linkedin target="_blank" rel="noopener noreferrer">post on LinkedIn</a>
        </div>
        <p data-status role="status"></p>
        <p>Attach the downloaded PNG to your post. Link previews show an example card: crawlers cannot see the numbers after <code>#</code>.</p>
        <p data-post-text></p>
      </section>
      <p class="privacy">Your numbers stay in this browser. Nothing is uploaded, and this page has no analytics. Anyone with your link can see the numbers in it.</p>
      <section class="install-area">
        <h2>Work with coding agents in parallel.</h2>
        <p>cornercase is a terminal for projects, git worktrees and coding agents. Keep their work side by side, see who needs you, and come back to running shells.</p>
        <InstallBox />
        <a href={`${base}docs/guides/projects-workspaces-tabs/`}>Learn about Usage and stats →</a>
      </section>
    </main>
    <script>import '../lib/stats/page';</script>
  </body>
</html>
<style>
  :root { color-scheme: dark; --font: 'Archivo Variable', ui-sans-serif, system-ui, sans-serif; --font-mono: 'JetBrains Mono Variable', monospace; --text: #eceef1; --text-2: #b6bcc4; --text-3: #8b929b; --surface: #15171b; --surface-2: #1d2025; --line: #262a30; --line-2: #383d45; --brand: #005fff; --brand-hover: #0050d8; --brand-ink: #74a3ff; --on-brand: #f7f8fa; --term: #1a1b26; --bg: #0b0c0e; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); }
  main { max-width: 1144px; margin: 0 auto; padding: 36px 24px 80px; }
  h1, h2, .home { font-stretch: 112%; letter-spacing: -0.035em; }
  h1 { font-size: clamp(34px, 5.4vw, 64px); font-weight: 780; line-height: 1; margin: 32px 0 12px; }
  h2 { font-size: clamp(26px, 3vw, 36px); font-weight: 760; margin: 0 0 12px; }
  p { color: var(--text-2); line-height: 1.6; }
  a { color: var(--brand-ink); text-decoration: none; font-weight: 600; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .home { color: var(--text); font-size: 22px; font-weight: 760; }
  .stage { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--line); margin: 18px 0; background: var(--bg); touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }
  .backdrop { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .space { position: absolute; left: 0; top: 0; width: 1200px; height: 675px; transform-origin: 0 0; }
  .blur, .ticket { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform; }
  .ticket { width: 1000px; height: 520px; }
  .ticket canvas { display: block; width: 100%; height: 100%; }
  .foil, .glare { position: absolute; inset: 0; overflow: hidden; pointer-events: none; mask-size: 100% 100%; -webkit-mask-size: 100% 100%; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; }
  .foil i, .glare i { position: absolute; left: 0; top: 0; will-change: transform; }
  @media (max-width: 600px) { .stage { margin-inline: -24px; border-inline: 0; } }
  [role='tablist'], .buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  button, .buttons a { border: 1px solid var(--line-2); color: var(--text); padding: 10px 16px; background: transparent; font: inherit; font-weight: 600; cursor: pointer; transition: border-color 0.15s ease, background-color 0.15s ease; }
  [aria-selected='true'], [data-download] { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
  button:hover, .buttons a:hover { border-color: var(--text); text-decoration: none; }
  [aria-selected='true']:hover, [data-download]:hover { background: var(--brand-hover); border-color: var(--brand-hover); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--brand-ink); outline-offset: 3px; }
  [hidden] { display: none !important; }
  .privacy { font-size: 15px; margin-top: 28px; }
  .install-area { border-top: 2px solid var(--text); margin-top: 48px; padding-top: 28px; max-width: 680px; }
  .install-area > a { display: inline-block; margin-top: 24px; }
  code { font-family: var(--font-mono); font-size: 0.9em; }
</style>
