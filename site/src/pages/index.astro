import More from '../components/landing/More.astro';
import Nav from '../components/landing/Nav.astro';
import Stats from '../components/landing/Stats.astro';
import Why from '../components/landing/Why.astro';
import Landing from '../layouts/Landing.astro';
---

<Landing
  title="cornercase · the fastest way to run agents in parallel"
  description="A fast terminal multiplexer for coding agents. Each agent gets its own git worktree and tab, and they keep working when you close the terminal. Everything works with clicks. Linux and macOS.">
  <Nav />
  <main id="main">
    <Hero />
    <Stats />
    <Why />
    <More />
  </main>
  <Footer />
</Landing>
