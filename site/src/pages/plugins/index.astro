---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/landing.css';
import { readFileSync } from 'node:fs';
import Footer from '../../components/landing/Footer.astro';
import Nav from '../../components/landing/Nav.astro';
import Avatar from '../../components/plugins/Avatar.astro';
import Command from '../../components/plugins/Command.astro';
import { MANIFEST, TOPIC, validate } from '../../lib/plugins/catalogue';
import { PAGE_SIZE, csp, headline, view } from '../../lib/plugins/page';

const dev = import.meta.env.DEV && process.env.PLUGINS_INDEX === 'dev';
const source = dev ? readFileSync('plugins/index.dev.json', 'utf8') : (await import('../../../plugins/index.json?raw')).default;
const page = view(validate(source));
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL('https://usecornercase.dev');
const guide = `${base}docs/guides/plugins/`;
const number = (n: number) => n.toLocaleString('en-US');
const day = (iso: string) => iso.slice(0, 10);
const description = `Community plugins for cornercase, published on GitHub and found by their ${TOPIC} topic. Install any of them with cornercase plugin install.`;
const rest = page.line.slice(2);
const topicCommand = `gh repo edit --add-topic ${TOPIC}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp(import.meta.env.DEV)} />
    <title>cornercase plugins</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(`${base}plugins/`, origin)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#07060b" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="cornercase plugins" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}og.png`, origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="plugins-page">
    <a class="skip" href="#main">Skip to content</a>
    <Nav standalone />
    <main id="main">
      <div class="wrap">
        <header class="intro">
          <p class="eyebrow cmd-line" aria-hidden="true">$ cornercase plugin list</p>
          <h1>Extend your terminal.</h1>
          <p class="out">{headline(page.plugins, page.repos)}</p>
          <p class="lead">
            Small tools other people built on cornercase's commands. Install one with <code>cornercase plugin install</code>.
          </p>
          <p class="trust">
            <span class="dot" aria-hidden="true"></span>
            Listings aren't reviewed, so install at your own discretion.
            <a href={`${guide}#trust-and-security`}>Trust guidance →</a>
          </p>
        </header>

        {
          page.trending.length > 0 && (
            <section class="shelf" id="shelf-trending" aria-labelledby="trending-title">
              <div class="shelf-head">
                <div>
                  <p class="eyebrow cmd-line" aria-hidden="true">$ sort --stars --since 7d</p>
                  <h2 id="trending-title">Rising this week</h2>
                </div>
                <button type="button" class="see" data-see="trending">see all →</button>
              </div>
              <ul class="trend-grid">
                {page.trending.map((card) => (
                  <li class="card trend">
                    <div class="who">
                      <Avatar owner={card.owner} />
                      <a class="repo" href={`https://github.com/${card.repo}`} target="_blank" rel="noopener noreferrer">
                        <span class="owner">{card.owner}/</span>
                        <b>{card.name}</b>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </div>
                    <p class="badge">
                      <span aria-hidden="true">▲ </span>
                      {number(card.before ?? 0)} → {number(card.stars)} <span aria-hidden="true">★</span><span class="sr-only"> stars</span> this week
                    </p>
                    <p class="desc clamp">{card.description ?? 'No description provided.'}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          page.fresh.length > 0 && (
            <section class="shelf" id="shelf-new" aria-labelledby="new-title">
              <div class="shelf-head">
                <div>
                  <p class="eyebrow cmd-line" aria-hidden="true">$ ls --newest</p>
                  <h2 id="new-title">Just landed</h2>
                </div>
                <button type="button" class="see" data-see="newest">see all →</button>
              </div>
              <ul class="new-rows">
                {page.fresh.map((card) => (
                  <li class="row">
                    <Avatar owner={card.owner} />
                    <a class="repo" href={`https://github.com/${card.repo}`} target="_blank" rel="noopener noreferrer">
                      <span class="owner">{card.owner}/</span>
                      <b>{card.name}</b>
                      <span aria-hidden="true"> ↗</span>
                    </a>
                    <p class="desc line">{card.description ?? 'No description provided.'}</p>
                    <p class="right">
                      <time datetime={card.joined} data-ago="joined">✦ joined {day(card.joined)}</time>
                      <span class="stars"><span aria-hidden="true">★</span> {number(card.stars)}<span class="sr-only"> stars</span></span>
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          !page.empty && (
            <section class="browse" aria-labelledby="browse-title">
              <div class="shelf-head">
                <div>
                  <p class="eyebrow cmd-line" aria-hidden="true">$ ls --all</p>
                  <h2 id="browse-title">Every plugin</h2>
                </div>
              </div>
              <div class="controls">
                <label class="search">
                  <span class="slash" aria-hidden="true">/</span>
                  <input type="search" data-search placeholder="search plugins, repositories, owners, languages…" autocomplete="off" spellcheck="false" aria-label="Search plugins" />
                </label>
                <label class="sort">
                  <span>sort</span>
                  <select data-sort aria-label="Sort plugins">
                    <option value="popular" selected>Popular</option>
                    <option value="trending">Trending</option>
                    <option value="recent">Recently updated</option>
                    <option value="newest">Newest</option>
                    <option value="name">Name</option>
                  </select>
                </label>
              </div>
              <p class="line" data-line aria-live="polite">
                <span data-line-count>{page.line.slice(0, 2).join(' · ')}</span>
                {rest.map((part) => <><span aria-hidden="true"> · </span><span>{part}</span></>)}
                <span aria-hidden="true"> · </span><time datetime={page.generated} data-ago="updated">updated {day(page.generated)}</time>
              </p>
              <p class="empty" data-none hidden>No plugins match your search.</p>
              <ul class="grid" data-grid data-page={PAGE_SIZE}>
                {page.cards.map((card) => (
                  <li
                    class="card"
                    data-card
                    data-haystack={card.haystack}
                    data-plugins={card.plugins.length}
                    data-rank-popular={card.ranks.popular}
                    data-rank-trending={card.ranks.trending}
                    data-rank-recent={card.ranks.recent}
                    data-rank-newest={card.ranks.newest}
                    data-rank-name={card.ranks.name}
                  >
                    <div class="who">
                      <Avatar owner={card.owner} />
                      <a class="repo" href={`https://github.com/${card.repo}`} target="_blank" rel="noopener noreferrer">
                        <span class="owner">{card.owner}/</span>
                        <b>{card.name}</b>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </div>
                    <p class={card.description ? 'desc' : 'desc none'}>{card.description ?? 'No description provided.'}</p>
                    <p class="meta">
                      <span><span aria-hidden="true">★</span> {number(card.stars)}<span class="sr-only"> stars</span></span>
                      {card.language && (
                        <span class="lang">
                          <i class="lang-dot" data-lang={card.coloured ? card.language : undefined} aria-hidden="true"></i>
                          {card.language}
                        </span>
                      )}
                      {card.plugins.length === 1 && <span>v{card.plugins[0].version.replace(/^v/, '')}</span>}
                      <time class="pushed" datetime={card.pushed} data-ago="updated">updated {day(card.pushed)}</time>
                    </p>
                    {card.plugins.length === 1 ? (
                      <Command command={card.plugins[0].command} label={card.plugins[0].name} />
                    ) : (
                      <details class="many">
                        <summary>
                          <span class="pill">{card.plugins.length} plugins</span>
                          <span class="names">{card.plugins.map((p) => p.name).join(', ')}</span>
                        </summary>
                        <ul>
                          {card.plugins.map((p) => (
                            <li>
                              <p class="plugin-name"><b>{p.name}</b> <span>v{p.version.replace(/^v/, '')}</span></p>
                              <Command command={p.command} label={p.name} />
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </li>
                ))}
              </ul>
              <p class="more-wrap"><button type="button" class="more" data-more hidden>show more</button></p>
            </section>
          )
        }

        <section class="publish" aria-labelledby="publish-title">
          <div class="shelf-head">
            <div>
              <p class="eyebrow cmd-line" aria-hidden="true">$ {topicCommand}</p>
              <h2 id="publish-title">{page.empty ? 'Publish the first one' : 'Publish yours'}</h2>
            </div>
          </div>
          <p class="after">
            Add a <code>{MANIFEST}</code> to a public repository, then tag it with the topic. {page.empty ? 'Your plugin' : 'It'} shows up here on the next refresh, with no submission and no review.
          </p>
          <p class="guide-link"><a href={`${guide}#publish-a-plugin`}>How publishing works →</a></p>
          <div class="term">
            <span class="ps" aria-hidden="true">$</span>
            <code>{topicCommand}</code>
            <button type="button" class="copy" data-plugin-copy={topicCommand} aria-label="Copy the command that adds the topic">copy</button>
          </div>
        </section>
      </div>
    </main>
    <Footer standalone />
    <script>
      import '../../lib/plugins/client';
    </script>
  </body>
</html>

<style is:global>
  .plugins-page main {
    padding: clamp(40px, 7vw, 84px) 0 clamp(56px, 8vw, 110px);
  }
  .plugins-page .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .plugins-page h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(34px, 5.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .plugins-page .lead {
    max-width: 640px;
    margin: 18px 0 0;
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--text-2);
    text-wrap: pretty;
  }
  .plugins-page .lead code,
  .plugins-page .publish .after code {
    padding: 1px 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.07);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }
  .plugins-page .out {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  .plugins-page .trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 20px 0 0;
    font-size: 14.5px;
    color: var(--text-3);
  }
  .plugins-page .trust .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-3);
  }
  .plugins-page .trust a {
    color: var(--purple-2);
    text-decoration: none;
  }
  .plugins-page .trust a:hover {
    text-decoration: underline;
  }
  .plugins-page .shelf,
  .plugins-page .browse {
    margin-top: clamp(44px, 6vw, 72px);
  }
  .plugins-page .shelf-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .plugins-page h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 720;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.025em;
  }
  .plugins-page .cmd-line {
    margin: 0 0 8px;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--text-3);
  }
  .plugins-page .see,
  .plugins-page .more {
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: rgb(255 255 255 / 0.03);
    color: var(--text-2);
    font: inherit;
    font-size: 14px;
    padding: 6px 12px;
    cursor: pointer;
    white-space: nowrap;
  }
  .plugins-page .see:hover,
  .plugins-page .more:hover {
    color: var(--text);
    border-color: rgb(168 141 255 / 0.6);
  }
  .plugins-page ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plugins-page .trend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .plugins-page .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 14px;
  }
  .plugins-page .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .plugins-page .card:hover,
  .plugins-page .card:focus-within,
  .plugins-page .row:hover {
    border-color: rgb(168 141 255 / 0.5);
    background: var(--panel-2);
  }
  .plugins-page .who {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .plugins-page .avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel-2);
    color: var(--purple-3);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
  }
  .plugins-page .avatar img {
    display: block;
    width: 32px;
    height: 32px;
  }
  .plugins-page .repo {
    min-width: 0;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plugins-page .repo .owner {
    color: var(--text-3);
  }
  .plugins-page .repo b {
    color: var(--text);
    font-weight: 650;
  }
  .plugins-page .repo:hover b {
    color: var(--purple-3);
  }
  .plugins-page .repo span[aria-hidden] {
    color: var(--text-3);
  }
  .plugins-page .badge {
    margin: 0;
    width: fit-content;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(88 230 160 / 0.12);
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .plugins-page .desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .plugins-page .desc.none {
    font-style: italic;
    color: var(--text-3);
  }
  .plugins-page .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .plugins-page .new-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .plugins-page .row {
    display: grid;
    grid-template-columns: auto minmax(0, 14rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .plugins-page .row .desc.line {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plugins-page .row .right {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 13.5px;
    color: var(--text-3);
    white-space: nowrap;
  }
  .plugins-page .row .right time {
    color: var(--purple-2);
  }
  .plugins-page .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .plugins-page .search {
    position: relative;
    flex: 1 1 18rem;
    min-width: 0;
  }
  .plugins-page .slash {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    padding: 0 6px;
    border: 1px solid var(--line-2);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    pointer-events: none;
  }
  .plugins-page .search input,
  .plugins-page .sort select {
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 11px;
    background: var(--bg-2);
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .plugins-page .search input {
    width: 100%;
    padding: 0 14px 0 44px;
  }
  .plugins-page .sort {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .plugins-page .sort select {
    padding: 0 12px;
    text-transform: none;
    letter-spacing: 0;
  }
  .plugins-page .line {
    margin: 14px 0 18px;
    font-size: 14px;
    color: var(--text-3);
  }
  .plugins-page .empty {
    margin: 24px 0;
    color: var(--text-2);
  }
  .plugins-page .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .plugins-page .meta .pushed {
    margin-left: auto;
  }
  .plugins-page .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .plugins-page .lang-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text-3);
  }
  .plugins-page .lang-dot[data-lang='TypeScript'] {
    background: #3178c6;
  }
  .plugins-page .lang-dot[data-lang='JavaScript'] {
    background: #f1e05a;
  }
  .plugins-page .lang-dot[data-lang='Rust'] {
    background: #dea584;
  }
  .plugins-page .lang-dot[data-lang='Python'] {
    background: #3572a5;
  }
  .plugins-page .lang-dot[data-lang='Go'] {
    background: #00add8;
  }
  .plugins-page .lang-dot[data-lang='Lua'] {
    background: #000080;
  }
  .plugins-page .lang-dot[data-lang='Shell'] {
    background: #89e051;
  }
  .plugins-page .lang-dot[data-lang='C++'] {
    background: #f34b7d;
  }
  .plugins-page .lang-dot[data-lang='Ruby'] {
    background: #701516;
  }
  .plugins-page .cmd {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 8px 8px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--term);
  }
  .plugins-page .cmd code {
    flex: 1;
    min-width: 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text);
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .plugins-page .copy {
    flex: none;
    border: 1px solid var(--line-2);
    border-radius: 7px;
    background: rgb(255 255 255 / 0.04);
    color: var(--text-2);
    font: inherit;
    font-size: 12.5px;
    padding: 3px 10px;
    cursor: pointer;
  }
  .plugins-page .copy:hover {
    color: var(--text);
    border-color: rgb(168 141 255 / 0.6);
  }
  .plugins-page .many summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    cursor: pointer;
    list-style: none;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .plugins-page .many summary::-webkit-details-marker {
    display: none;
  }
  .plugins-page .many .pill {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(135 95 255 / 0.18);
    color: var(--purple-3);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .plugins-page .many .names {
    overflow-wrap: anywhere;
  }
  .plugins-page .many ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
  }
  .plugins-page .plugin-name {
    margin: 0 0 6px;
    font-size: 14px;
  }
  .plugins-page .plugin-name span {
    color: var(--text-3);
  }
  .plugins-page .more-wrap {
    margin: 22px 0 0;
    text-align: center;
  }
  .plugins-page .publish {
    margin-top: clamp(48px, 7vw, 88px);
    max-width: 760px;
  }
  .plugins-page .term {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 8px 8px 8px 18px;
    border-radius: 13px;
    border: 1px solid rgb(135 95 255 / 0.45);
    background: linear-gradient(180deg, rgb(135 95 255 / 0.1), rgb(135 95 255 / 0.03)), var(--term);
    box-shadow: 0 18px 50px -24px rgb(135 95 255 / 0.65);
  }
  .plugins-page .term .ps {
    flex: none;
    color: var(--purple-2);
    font-family: var(--font-mono);
    font-size: 15px;
    user-select: none;
  }
  .plugins-page .term code {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .plugins-page .term .copy {
    height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 9px;
    background: #7552f2;
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
  }
  .plugins-page .term .copy:hover {
    background: #6d48f5;
    color: #fff;
  }
