---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import source from '../../../plugins/index.json?raw';
import { MANIFEST, TOPIC, installCommand, sourceUrl, validate } from '../../lib/plugins/catalogue';

const { generated, plugins } = validate(source);
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/usecornercase/cornercase-terminal';
const platforms = (list?: string[]) => (list?.length ? list.join(', ') : 'macOS and Linux');
const updated = new Date(generated).toISOString().slice(0, 16).replace('T', ' ');
---
<StarlightPage
  frontmatter={{
    title: 'Plugins',
    description: `Plugins for cornercase, found on GitHub by their ${TOPIC} topic. Install one with cornercase plugin install.`,
  }}
>
  <p>
    Every public GitHub repository with the <code>{TOPIC}</code> topic and a valid <code>{MANIFEST}</code> at its root is
    listed here, refreshed every 30 minutes. What a plugin is and how to write one is in the
    <a href={`${base}docs/guides/plugins/`}>plugins guide</a>. The list is also published as
    <a href={`${base}plugins/index.json`}><code>index.json</code></a>.
  </p>

  <Aside type="caution" title="Nobody reviews these plugins">
    They are listed automatically. A plugin runs as you: once on, it can do anything you can, including typing into every
    terminal, and the permissions it lists are shown, not enforced. Read its code or trust its author before you turn it on.
  </Aside>

  <h2 id="plugins">Plugins</h2>
  <p>{plugins.length === 1 ? '1 plugin' : `${plugins.length} plugins`}, most starred first. Updated {updated} UTC.</p>
  {plugins.length === 0 ? (
    <p data-empty>No plugins are listed yet. Yours could be the first: see <a href="#publish">publish a plugin</a>.</p>
  ) : (
    plugins.map((plugin) => (
      <section data-plugin={plugin.id}>
        <h3>{plugin.name} <small>{plugin.version} · ★ {plugin.stars}</small></h3>
        {plugin.description && <p>{plugin.description}</p>}
        <ul>
          <li>Source: <a href={sourceUrl(plugin)} rel="noopener noreferrer nofollow">{plugin.repo}</a>, commit <code>{plugin.commit.slice(0, 12)}</code></li>
          <li>Runs on: {platforms(plugin.platforms)}</li>
          <li>Asks for: {plugin.permissions?.length ? plugin.permissions.join(', ') : 'nothing'} (shown, not enforced)</li>
          {plugin.min_cornercase && <li>Needs cornercase {plugin.min_cornercase} or later</li>}
        </ul>
        <pre><code>{installCommand(plugin)}</code></pre>
      </section>
    ))
  )}

  <h2 id="install">Install one</h2>
  <p>
    Copy the command under a plugin. It installs the commit listed here: cornercase fetches it, shows where it comes from
    and every command it will run, and asks before installing. The plugin is installed turned off; turn it on in
    <strong>Settings › Plugins</strong> or with <code>cornercase plugin enable &lt;id&gt;</code>.
  </p>

  <h2 id="publish">Publish a plugin</h2>
  <ol>
    <li>Put your plugin in a public GitHub repository, with its <code>{MANIFEST}</code> at the root.</li>
    <li>Add the <code>{TOPIC}</code> topic to the repository (the gear next to <strong>About</strong>).</li>
  </ol>
  <p>
    That is all. Within 30 minutes it shows here, at the latest commit of its default branch, and each new commit replaces
    it at the next refresh. Forks, archived repositories and manifests that cannot be read are left out. When two
    repositories declare the same <code>id</code>, the older repository keeps it. The manifest's <code>name</code>,
    <code>version</code>, <code>description</code>, <code>platforms</code>, <code>permissions</code> and
    <code>min_cornercase</code> are what this page shows.
  </p>
  <p>
    A plugin that harms its users is removed through
    <a href={`${repo}/blob/main/site/plugins/blocklist.json`}><code>site/plugins/blocklist.json</code></a>.
    To report one, <a href={`${repo}/issues/new`}>open an issue</a>.
  </p>
</StarlightPage>
